MEMORY_FILE = Path.home() / ".sentinel_memory.json"
_memory_lock = threading.RLock()

def load_memory():
    if not MEMORY_FILE.exists():
        return {}
    try:
        data = json.loads(MEMORY_FILE.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as e:
        # Do not return an empty dict on corruption: a subsequent write would erase the recoverable file.
        raise HTTPException(503, "Memory file is unreadable; repair or back it up before changing memory.") from e
    if not isinstance(data, dict):
        raise HTTPException(503, "Memory file has an invalid format; repair it before changing memory.")
    return data

def save_memory(data):
    tmp_path = None
    try:
        MEMORY_FILE.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=MEMORY_FILE.parent,
                                         prefix=MEMORY_FILE.name + ".", suffix=".tmp", delete=False) as tmp:
            tmp_path = Path(tmp.name)
            json.dump(data, tmp, indent=2, ensure_ascii=False)
            tmp.flush()
            os.fsync(tmp.fileno())
        os.replace(tmp_path, MEMORY_FILE)
        return True
    except OSError as e:
        print(f"[Error] Memory writing failure: {e}")
        if tmp_path:
            try: tmp_path.unlink(missing_ok=True)
            except OSError: pass
        return False

# ── ENVIRONMENT RESOLVER ──
def _cpu_model():
    try:
        r = subprocess.run(["grep","-m1","model name","/proc/cpuinfo"], capture_output=True, text=True, timeout=2)
        if r.returncode == 0: return r.stdout.split(":")[1].strip()
    except Exception as e: print(f"[Metrics System] /proc/cpuinfo unreadable: {e}")
    return platform.processor() or "Intel i7-6700"

def _distro():
    try:
        r = subprocess.run(["lsb_release","-ds"], capture_output=True, text=True, timeout=2)
        if r.returncode == 0: return r.stdout.strip().strip('"')
    except: pass
    try: return Path("/etc/os-release").read_text().split('PRETTY_NAME="')[1].split('"')[0]
    except Exception as e: print(f"[Metrics System] Target OS fingerprint failed: {e}")
    return platform.system()

def _cpu_temp():
    """Hottest CPU sensor reading in °C, or None when the machine exposes no temperature sensors."""
    try:
        temps = psutil.sensors_temperatures() or {}
        for key in ("coretemp", "k10temp", "zenpower", "cpu_thermal", "acpitz"):
            if temps.get(key):
                return round(max(t.current for t in temps[key]))
    except Exception:
        pass
    return None

