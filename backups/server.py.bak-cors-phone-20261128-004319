@app.post("/desktop/input", dependencies=[Depends(verify_key)])
def desktop_input(req: DesktopInputReq):
    """Perform one bounded desktop input without invoking a shell."""
    xdotool = shutil.which("xdotool")
    if not xdotool:
        raise HTTPException(503, "Desktop input requires xdotool (X11).")
    if os.environ.get("XDG_SESSION_TYPE", "").lower() == "wayland":
        raise HTTPException(503, "Desktop input is not available in this Wayland session yet.")
    try:
        width = height = None
        xwininfo = shutil.which("xwininfo")
        if xwininfo:
            root_info = subprocess.run([xwininfo, "-root"], capture_output=True, text=True, timeout=3)
            width_match = re.search(r"^\s*Width:\s*(\d+)\s*$", root_info.stdout, re.MULTILINE)
            height_match = re.search(r"^\s*Height:\s*(\d+)\s*$", root_info.stdout, re.MULTILINE)
            if root_info.returncode == 0 and width_match and height_match:
                width, height = int(width_match.group(1)), int(height_match.group(1))
        if width is None or height is None:
            xrandr = shutil.which("xrandr")
            if xrandr:
                root_info = subprocess.run([xrandr, "--current"], capture_output=True, text=True, timeout=3)
                root_match = re.search(r"^Screen \d+:.*current (\d+) x (\d+)", root_info.stdout, re.MULTILINE)
                if root_info.returncode == 0 and root_match:
                    width, height = int(root_match.group(1)), int(root_match.group(2))
        if width is None or height is None:
            raise HTTPException(503, "Could not read full desktop dimensions with xwininfo or xrandr.")
        action = req.action
        if action == "click":
            if req.x is None or req.y is None or not (0 <= req.x < width and 0 <= req.y < height):
                raise HTTPException(400, "Click coordinates are outside the current screen.")
            clicks = req.clicks or 1
            if clicks not in (1, 2):
                raise HTTPException(400, "Only single or double clicks are allowed.")
            subprocess.run([xdotool, "mousemove", "--sync", str(req.x), str(req.y)], check=True, timeout=10)
            subprocess.run([xdotool, "click", "--repeat", str(clicks), "1"], check=True, timeout=5)
        elif action == "type":
            value = req.text or ""
            if not value or len(value) > 1000 or "\x00" in value:
                raise HTTPException(400, "Typed text must contain 1 to 1000 characters.")
            subprocess.run([xdotool, "type", "--clearmodifiers", "--delay", "15", value], check=True, timeout=45)
        elif action == "key":
            raw_key = (req.key or "").strip()
            key_aliases = {"enter": ("return", "Return"), "esc": ("escape", "Escape"), "escape": ("escape", "Escape"), "return": ("return", "Return"), "backspace": ("backspace", "BackSpace"), "pageup": ("page_up", "Page_Up"), "pagedown": ("page_down", "Page_Down"), "super": ("super_l", "Super_L"), "super_l": ("super_l", "Super_L"), "meta": ("super_l", "Super_L"), "win": ("super_l", "Super_L"), "space": ("space", "space"), "tab": ("tab", "Tab")}
            modifier_aliases = {"control": "ctrl", "ctl": "ctrl", "command": "ctrl", "cmd": "ctrl", "windows": "super", "meta": "super", "win": "super"}
            raw_parts = [part.strip().lower() for part in raw_key.split("+")]
            if not raw_parts or any(not part for part in raw_parts):
                raise HTTPException(400, f"The desktop planner sent an empty or malformed key ({raw_key!r}); no input was sent.")
            parts = [modifier_aliases.get(part, part) for part in raw_parts]
            final_alias = key_aliases.get(parts[-1])
            if final_alias:
                parts[-1] = final_alias[0]
                final_key = final_alias[1]
            else:
                final_key = raw_parts[-1]
                if len(final_key) == 1:
                    final_key = final_key.lower()
                elif final_key.startswith("page_"):
                    final_key = "Page_" + final_key[5:].title()
                else:
                    final_key = final_key[:1].upper() + final_key[1:]
            canonical_key = "+".join(parts)
            allowed_keys = {"return", "tab", "escape", "backspace", "delete", "space", "up", "down", "left", "right", "home", "end", "page_up", "page_down", "super_l", "ctrl+return", "ctrl+a", "ctrl+c", "ctrl+v", "ctrl+x", "ctrl+z", "ctrl+y", "ctrl+l", "ctrl+t", "ctrl+w", "ctrl+r", "ctrl+f", "ctrl+shift+t", "shift+tab", "alt+tab", "alt+f2", "super+space"}
            if canonical_key not in allowed_keys:
                raise HTTPException(400, f"That key or key combination is not allowed ({raw_key!r}).")
            normalized_key = "+".join(parts[:-1] + [final_key])
            subprocess.run([xdotool, "key", "--clearmodifiers", normalized_key], check=True, timeout=5)
        elif action == "scroll":
            if req.direction not in ("up", "down") or req.x is None or req.y is None or not (0 <= req.x < width and 0 <= req.y < height):
                raise HTTPException(400, "Scroll direction or coordinates are invalid.")
            clicks = req.clicks or 1
            if clicks not in range(1, 6):
                raise HTTPException(400, "Scroll is limited to five increments per action.")
            subprocess.run([xdotool, "mousemove", "--sync", str(req.x), str(req.y)], check=True, timeout=10)
            button = "4" if req.direction == "up" else "5"
            subprocess.run([xdotool, "click", "--repeat", str(clicks), "--delay", "100", button], check=True, timeout=5)
        else:
            raise HTTPException(400, "Unsupported desktop input action.")
        return {"ok": True, "action": action, "width": width, "height": height}
    except HTTPException:
        raise
    except subprocess.TimeoutExpired as e:
        raise HTTPException(408, "Desktop input timed out.") from e
    except (OSError, ValueError, subprocess.CalledProcessError) as e:
        raise HTTPException(500, f"Desktop input failed: {e}") from e

