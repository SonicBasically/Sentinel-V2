voice_replies = deque(maxlen=20)   # pending replies; one is handed out per poll
_voice_bg = set()                  # keeps fire-and-forget tasks from being garbage collected

def get_vosk_model():
    global vosk_model
    if vosk_model is None:
        print("[Voice Stack] Loading Vosk model...")
        import vosk
        vosk.SetLogLevel(-1)
        model_path = Path(os.environ.get(
            "SENTINEL_VOSK_MODEL",
            str(Path.home() / "Desktop" / "OG_Drive" / "Models" / "vosk" / "vosk-model-en-us-0.22-lgraph")
        )).expanduser()
        if model_path.is_dir():
            print(f"[Voice Stack] Using Vosk model at {model_path}")
            vosk_model = vosk.Model(str(model_path))
        else:
            print(f"[Voice Stack] Model path missing ({model_path}); using Vosk's default en-us model.")
            vosk_model = vosk.Model(lang="en-us")
    return vosk_model

voice_conversation_history = []
cmd_gen = 0              # bumps for every voice command, so a waiting follow-up can tell something newer took over
listen_request = False   # set after Sentinel asks a question: the mic opens without "Hey Sentinel"
pending_choice = None    # {"choices": [...], "until": t} after "Which one did you mean: A, B?"

VOICE_HANDOFF = os.environ.get("SENTINEL_VOICE_HANDOFF", "1") != "0"   # 0 = answer spoken requests in the backend (old way)

def _push_reply(transcript, reply):
    """Queues a reply for the UI. 'followup' marks replies that end in a question."""
    item = {"transcript": transcript, "reply": reply, "tts0": _tts_count,
            "followup": bool(wake_lib.FOLLOWUP_ENABLED and wake_lib.is_question(reply))}
    voice_replies.append(item)
    return item

async def handle_voice_intent(text: str):
    global pending_choice
    print(f"[Voice Brain] Processing: '{text}'")
    choice, pending_choice = pending_choice, None   # an answer only counts for the very next thing said
    if choice and time.monotonic() < choice["until"]:
        try:
            ans = await asyncio.to_thread(voice_commands.answer_choice, text, choice["choices"])
        except Exception as e:
            print(f"[Voice Command Error]: {e}")
            ans = None
        if ans:
            print(f"[Voice Command] {ans['reply'][:80]}")
            return _push_reply(text, ans["reply"])
    try:
        cmd = await asyncio.to_thread(voice_commands.try_command, text, APP_ALIASES)
    except Exception as e:
        print(f"[Voice Command Error]: {e}")
        cmd = {"reply": "Something went wrong running that command."}
    if cmd:
        if cmd.get("choices"):
            pending_choice = {"choices": cmd["choices"], "until": time.monotonic() + 60}
        print(f"[Voice Command] {cmd['reply'][:80]}")
        return _push_reply(text, cmd["reply"])
    if VOICE_HANDOFF:
        # Not a simple command: the chat window answers it with the mode docs and the action loop, like typed chat.
        item = {"transcript": text, "reply": "", "handoff": True, "followup": False, "tts0": _tts_count}
        voice_replies.append(item)
        print("[Voice Brain] Handed to the chat window.")
        return item
    try:
        from ollama_brain import process_chat_with_brain
        result = await process_chat_with_brain(text, use_tools=False, history=voice_conversation_history)
        reply = (result or {}).get("reply") or "I couldn't reach my local model."
    except Exception as e:
        print(f"[Voice Brain Error]: {e}")
        reply = "Something went wrong while processing that."
    clean = re.sub(r"<ACTION\b[^>]*>[\s\S]*?</ACTION\s*>", "", reply, flags=re.IGNORECASE)
    clean = re.sub(r"</?ACTION\b[^>]*>", "", clean, flags=re.IGNORECASE).strip()
    item = _push_reply(text, clean)
    print(f"[Voice Brain] Reply: {clean[:80]}")
    return item

def _spawn(coro):
    t = asyncio.create_task(coro)
    _voice_bg.add(t)
    t.add_done_callback(_voice_bg.discard)
    return t

async def _open_followup(item, gen):
    """Sentinel asked a question: wait until the UI has taken the reply and it has been spoken, then ask the
    capture loop to open the mic (listen_request) so the answer needs no "Hey Sentinel"."""
    global wake_state, listen_request
    try:
        deadline = time.monotonic() + 10
        while any(r is item for r in voice_replies):       # 1. the UI picks replies up about once a second
            if time.monotonic() > deadline:
                print("[Wake] Nobody picked up the question, not opening the mic.")
                return
            await asyncio.sleep(0.2)
        deadline = time.monotonic() + 6
        while _tts_count == item["tts0"] and time.monotonic() < deadline:   # 2. the spoken version starts
            await asyncio.sleep(0.2)
        if _tts_count != item["tts0"]:
            deadline = time.monotonic() + 30
            while _tts_proc is not None and _tts_proc.poll() is None and time.monotonic() < deadline:
                await asyncio.sleep(0.2)                    # 3. and finishes
        else:
            await asyncio.sleep(min(len(item["reply"]) / 14.0, 8.0))   # no desktop voice (TTS off or phone): estimate
        await asyncio.sleep(0.4)                            # let the room go quiet
        if not mic_active or cmd_gen != gen or wake_state == "awake":
            return                                          # mic turned off, or something newer took over
        listen_request = True
        for _ in range(30):
            if not listen_request:
                break
            await asyncio.sleep(0.1)
    finally:
        if cmd_gen == gen:
            listen_request = False
            if wake_state == "busy":
                wake_state = "idle"

async def _run_wake_command(text: str):
    global wake_state, cmd_gen
    cmd_gen += 1
    gen = cmd_gen
    item = None
    try:
        item = await handle_voice_intent(text)
    finally:
        if item and item.get("followup") and mic_active:
            print("[Wake] That was a question, the mic will open for the answer.")
            _spawn(_open_followup(item, gen))   # stays "busy" until the mic opens or it gives up
        elif wake_state == "busy":
            wake_state = "idle"   # command finished: back to waiting for "Hey Sentinel"

async def continuous_mic_capture():
    # Wake-phrase loop. The mic stays open while wake listening is on, but nothing is acted on until
    # "Hey Sentinel" is heard:  idle -> (phrase) -> awake -> (command) -> busy -> (done) -> idle.
    # awake also falls back to idle after wake_lib.WAKE_TIMEOUT seconds without speech.
    global mic_active, wake_state, listen_request
    loop = asyncio.get_running_loop()
    audio_q = asyncio.Queue()
    vosk_pool = ThreadPoolExecutor(max_workers=1, thread_name_prefix="sentinel-vosk")
    max_audio_chunks = 8
    falling_behind_warned = False
    wake_deadline = 0.0

    # Silence gate: Vosk only gets audio while there is sound. Without it the recognizer decodes the
    # silence too and keeps a CPU core busy all day. SENTINEL_VAD_GATE=0 turns this off.
    gate_on = os.environ.get("SENTINEL_VAD_GATE", "1") != "0"
    gate_mult = float(os.environ.get("SENTINEL_VAD_MULT", "3"))     # opens at this many times the room's noise level
    gate_min = float(os.environ.get("SENTINEL_VAD_MIN", "60"))      # but never below this (int16 RMS)
    gate_hang_chunks = 8                                           # keep decoding ~1.5s after the last loud chunk
    gate_floor = None                                              # room noise level, learned in the first ~2s
    gate_calib = []
    gate_hang = 0
    gate_was_open = True
    gate_prev = None                                               # last quiet chunk, so the start of a word is not clipped
    gate_stats = [0, 0, time.monotonic()]                          # skipped, total, since
    try:
        import numpy as np
    except Exception:
        np = None
        gate_on = False

    def _chunk_rms(b):
        a = np.frombuffer(b, dtype=np.int16).astype(np.float32)
        return float(np.sqrt(np.mean(a * a))) if a.size else 0.0

    def callback(indata, frames, t, status):
        if status:
            print(status, file=sys.stderr)
        chunk = bytes(indata)
        def enqueue_chunk():
            nonlocal falling_behind_warned
            while audio_q.qsize() >= max_audio_chunks:
                try:
                    audio_q.get_nowait()
                    if not falling_behind_warned:
                        print("[Voice Stack] Falling behind, dropping audio")
                        falling_behind_warned = True
                except asyncio.QueueEmpty:
                    break
            audio_q.put_nowait(chunk)
        loop.call_soon_threadsafe(enqueue_chunk)

    try:
        import sounddevice as sd
        from vosk import KaldiRecognizer
        wake_state = "loading"
        model = await loop.run_in_executor(None, get_vosk_model)
        samplerate = int(sd.query_devices(None, "input")["default_samplerate"])
        recognizer = KaldiRecognizer(model, samplerate)
        with sd.RawInputStream(samplerate=samplerate, blocksize=8000, dtype="int16",
                               channels=1, callback=callback):
            wake_state = "idle"
            print("[Voice Stack] Microphone on. Say 'Hey Sentinel'.")
            while mic_active:
                try:
                    data = await asyncio.wait_for(audio_q.get(), timeout=0.5)
                except asyncio.TimeoutError:
                    data = None
                if wake_state == "awake" and time.monotonic() > wake_deadline:
                    print("[Wake] No command heard, back to listening for the phrase.")
                    wake_state = "idle"
                if listen_request and wake_state == "busy":
                    listen_request = False                   # Sentinel asked a question: listen for the answer
                    await loop.run_in_executor(None, wake_lib.chime)
                    while not audio_q.empty():               # drop what the speaker and the beep fed into the mic
                        audio_q.get_nowait()
                    await loop.run_in_executor(vosk_pool, recognizer.Reset)
                    wake_state = "awake"
                    wake_deadline = time.monotonic() + wake_lib.FOLLOWUP_TIMEOUT
                    print("[Wake] Listening for the answer.")
                    continue
                if data is None:
                    continue
                if gate_on:
                    level = _chunk_rms(data)
                    gate_stats[1] += 1
                    if time.monotonic() - gate_stats[2] > 300:
                        print(f"[Voice Stack] Silence gate: skipped {gate_stats[0]} of {gate_stats[1]} chunks in the last 5 minutes.")
                        gate_stats[:] = [0, 0, time.monotonic()]
                    if gate_floor is None:
                        gate_calib.append(level)                 # first ~2 seconds: learn the room, decode everything
                        if len(gate_calib) >= 12:
                            gate_floor = sorted(gate_calib)[len(gate_calib) // 2]
                            print(f"[Voice Stack] Silence gate on (room level {gate_floor:.0f}, opens above {max(gate_min, gate_floor * gate_mult):.0f}).")
                    elif wake_state != "idle":
                        gate_hang = gate_hang_chunks             # awake or busy: always decode
                        gate_was_open = True
                        gate_prev = None
                    else:
                        if level >= max(gate_min, gate_floor * gate_mult):
                            gate_hang = gate_hang_chunks
                        elif level < gate_floor:
                            gate_floor = 0.8 * gate_floor + 0.2 * level     # room got quieter: follow it quickly
                        else:
                            gate_floor = 0.98 * gate_floor + 0.02 * level   # room got louder: follow it slowly
                        if gate_hang <= 0:
                            gate_prev = data
                            gate_stats[0] += 1
                            if gate_was_open:
                                gate_was_open = False
                                await loop.run_in_executor(vosk_pool, recognizer.Reset)   # drop any half-heard noise
                            continue
                        gate_hang -= 1
                        if not gate_was_open:
                            gate_was_open = True
                            if gate_prev is not None:
                                data = gate_prev + data
                            gate_prev = None
                decode_started = time.monotonic()
                accepted = await loop.run_in_executor(vosk_pool, recognizer.AcceptWaveform, data)
                if accepted:
                    result_json = await loop.run_in_executor(vosk_pool, recognizer.Result)
                    text = json.loads(result_json).get("text", "").strip()
                    if not text:
                        continue
                    heard, rest = wake_lib.strip_wake(text)
                    if heard and rest:
                        print(f"[Wake] Phrase and command together: '{text}'")
                        wake_state = "busy"
                        loop.run_in_executor(None, wake_lib.chime)
                        _spawn(_run_wake_command(rest))
                    elif heard:
                        print("[Wake] Heard the wake phrase.")
                        wake_state = "awake"
                        wake_deadline = time.monotonic() + 30    # do not expire while the acknowledgement plays
                        await loop.run_in_executor(None, wake_lib.acknowledge)
                        while not audio_q.empty():               # drop what the speaker fed back into the mic
                            audio_q.get_nowait()
                        await loop.run_in_executor(vosk_pool, recognizer.Reset)
                        wake_deadline = time.monotonic() + wake_lib.WAKE_TIMEOUT
                    elif wake_state == "awake" and not wake_lib.is_noise(text):
                        print(f"[Voice Captured]: {text}")
                        wake_state = "busy"
                        _spawn(_run_wake_command(text))
                elif wake_state == "awake":
                    partial_json = await loop.run_in_executor(vosk_pool, recognizer.PartialResult)
                    if json.loads(partial_json).get("partial"):
                        wake_deadline = time.monotonic() + wake_lib.WAKE_TIMEOUT   # still talking, keep waiting
                elapsed = time.monotonic() - decode_started
                if elapsed > len(data) / (samplerate * 2):
                    print(f"[Voice Stack] Vosk decode took {elapsed:.2f}s for {len(data) / (samplerate * 2):.2f}s of audio")
                await asyncio.sleep(0)
    except Exception as e:
        print(f"[Voice Stack Error]: {e}")
    finally:
        mic_active = False
        wake_state = "idle"
        vosk_pool.shutdown(wait=False, cancel_futures=True)
        print("[Voice Stack] Microphone off.")

@app.post("/api/voice/start", dependencies=[Depends(verify_key)])
async def start_voice_listening():
    # Turns wake listening on (the mic button). The choice is saved and survives restarts.
    global voice_task, mic_active
    wake_lib.save_enabled(True)
    if mic_active:
        return {"status": "already_listening"}
    mic_active = True
    voice_task = asyncio.create_task(continuous_mic_capture())
    return {"status": "listening_started"}

@app.post("/api/voice/stop", dependencies=[Depends(verify_key)])
async def stop_voice_listening():
    # Turns wake listening off: the mic stream is closed and nothing is heard until it is turned back on.
    global voice_task, mic_active
    wake_lib.save_enabled(False)
    if not mic_active:
        return {"status": "already_stopped"}
    task, voice_task = voice_task, None
    mic_active = False   # the capture loop notices within 0.5s and closes the stream
    if task:
        try:
            await asyncio.wait_for(task, timeout=2)
        except Exception:
            pass
    return {"status": "listening_stopped"}

@app.get("/api/voice/last_response", dependencies=[Depends(verify_key)])
async def get_last_voice_response():
    processing = bool(_voice_bg)
    wake = {"enabled": mic_active, "state": wake_state if mic_active else "off"}
    if voice_replies:
        r = voice_replies.popleft()
        return {
            "status": "new", "transcript": r["transcript"], "reply": r["reply"], "handoff": bool(r.get("handoff")),
            "listening": mic_active, "processing": processing, "wake": wake,
        }
    return {"status": "empty", "listening": mic_active, "processing": processing, "wake": wake}

class VoiceQuestionReq(BaseModel):
    reply: str = ""
    spoken: bool = False   # True if the desktop /tts started speaking it

@app.post("/api/voice/question", dependencies=[Depends(verify_key)])
async def voice_question(req: VoiceQuestionReq):
    """The chat window finished answering a spoken request. If the final reply asks something, open the mic for the answer."""
    global wake_state
    reply = (req.reply or "")[:2000]
    if not (mic_active and wake_lib.FOLLOWUP_ENABLED and wake_state == "idle" and wake_lib.is_question(reply)):
        return {"followup": False}
    wake_state = "busy"   # _open_followup hands over to the capture loop, or gives up and goes back to idle
    item = {"transcript": "", "reply": reply, "tts0": _tts_count - (1 if req.spoken else 0)}
    _spawn(_open_followup(item, cmd_gen))
    print("[Wake] The answer was a question, the mic will open for the reply.")
    return {"followup": True}

@app.on_event("startup")
async def _wake_autostart():
    # Wake listening is on by default. The on/off choice is saved in ~/.config/sentinel/voice.json.
    global voice_task, mic_active
    asyncio.get_running_loop().run_in_executor(None, wake_lib.prepare)   # builds the beep and spoken phrases (first run only)
    if wake_lib.load_enabled():
        mic_active = True
        voice_task = asyncio.create_task(continuous_mic_capture())

if __name__ == "__main__":
    import uvicorn
    print("\n  SENTINEL V2 — Backend Stack (HARDENED)")
    print("  ────────────────────────────────────────────")
    print("  http://localhost:8765")
    import socket
    tailscale_ip = ""
    try:
        result = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=3, check=True)
        candidate = result.stdout.strip().splitlines()[0]
        if candidate.startswith("100."):
            tailscale_ip = candidate
    except Exception as e:
        print(f"[Network] Tailscale IPv4 unavailable; backend will listen on localhost only: {e}")
    sockets = []
    for bind_ip in ["127.0.0.1"] + ([tailscale_ip] if tailscale_ip else []):
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind((bind_ip, 8765))
            sock.listen(2048)
            sockets.append(sock)
            print(f"[Network] Backend listening on {bind_ip}:8765")
        except OSError as e:
            sock.close()
            print(f"[Network] Could not bind backend to {bind_ip}:8765: {e}")
    if not sockets:
        raise RuntimeError("Could not bind backend to localhost or Tailscale")
    uvicorn.Server(uvicorn.Config(app, log_level="warning")).run(sockets=sockets)