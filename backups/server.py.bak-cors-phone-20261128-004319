_AUTH_MAX_FAILURES = 5
_AUTH_WINDOW_SECONDS = 900
_auth_lock = threading.Lock()
_auth_failures = {}
_auth_locked = {}
# This machine already has full access. Counting its mistakes would let one stale key (an old tab polling
# every second) lock the real UI out for 15 minutes, so loopback is checked but never counted or locked.
_LOOPBACK_CLIENTS = {"127.0.0.1", "::1"}

def verify_key(request: Request, x_api_key: str = Header(default="")):
    client = request.client.host if request.client else "unknown"
    if client in _LOOPBACK_CLIENTS:
        if not hmac.compare_digest(x_api_key.encode("utf-8"), API_KEY.encode("utf-8")):
            raise HTTPException(status_code=401, detail="Unauthorized")
        return
    now = time.monotonic()
    with _auth_lock:
        blocked_until = _auth_locked.get(client, 0)
        if blocked_until > now:
            raise HTTPException(status_code=429, detail="Too many invalid API keys; try again later.")
        if blocked_until:
            _auth_locked.pop(client, None)
        failures, started = _auth_failures.get(client, (0, now))
        if now - started >= _AUTH_WINDOW_SECONDS:
            _auth_failures.pop(client, None)
    # Constant-time comparison prevents timing-based key guessing.
    if not hmac.compare_digest(x_api_key.encode("utf-8"), API_KEY.encode("utf-8")):
        with _auth_lock:
            failures, started = _auth_failures.get(client, (0, now))
            if now - started >= _AUTH_WINDOW_SECONDS:
                failures, started = 0, now
            failures += 1
            if failures >= _AUTH_MAX_FAILURES:
                _auth_locked[client] = now + _AUTH_WINDOW_SECONDS
                _auth_failures.pop(client, None)
            else:
                _auth_failures[client] = (failures, started)
            if len(_auth_locked) > 4096:
                expired = [ip for ip, until in _auth_locked.items() if until <= now]
                for ip in expired:
                    _auth_locked.pop(ip, None)
        raise HTTPException(status_code=401, detail="Unauthorized")
    with _auth_lock:
        _auth_failures.pop(client, None)

