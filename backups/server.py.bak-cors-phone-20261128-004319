def safe(cmd):
    """Reject dangerous commands and side-effecting shell features before dispatch."""
    if not isinstance(cmd, str) or not cmd.strip() or len(cmd) > 2000 or "\n" in cmd or "\r" in cmd:
        return False
    if any(marker in cmd for marker in ("$(", "`", "<(", ">(")):
        return False
    # Single-quoted dollars are literal (needed for sed's '$p'); block environment expansion.
    unquoted_shell = re.sub(r"'[^']*'", "", cmd)
    if "$" in unquoted_shell:
        return False
    lowered = cmd.lower()
    if any(s in lowered for s in (".env", ".ssh", "id_rsa", "id_ed25519", ".gnupg", "/etc/shadow",
            "/etc/sudoers", ".aws", ".netrc", "password", "passwd", "secret", "token", "api_key",
            "api-key", ".bash_history", ".zsh_history", ".mozilla", ".librewolf", "login.json",
            "key4.db", "key3.db", ".config/sentinel", ".config/google-chrome", ".config/chromium",
            ".config/bravesoftware", "environ", "keyrings", ".sentinel_memory", "cookies", "login data")):
        return False
    unquoted = re.sub(r"'[^']*'|\"[^\"]*\"", "", cmd)
    if any(("*" in token or "?" in token or "{" in token or "[" in token) and
           ("/" in token or token.startswith(".")) for token in unquoted.split()):
        return False
    # Permit the common stderr-to-null form, but no arbitrary file input/output redirection.
    cmd_for_parse = cmd.replace("2>/dev/null", "")
    try:
        lexer = shlex.shlex(cmd_for_parse, posix=True, punctuation_chars=";&|<>")
        lexer.whitespace_split = True
        lexer.commenters = ""
        tokens = list(lexer)
    except ValueError:
        return False
    separators = {";", "&&", "||", "|", "&"}
    segments, current = [], []
    for token in tokens:
        if token in separators:
            if current:
                segments.append(current)
                current = []
        else:
            current.append(token)
    if current:
        segments.append(current)
    for i, token in enumerate(tokens):
        if token in (">", ">>", ">|", "<", "<<", "<<<", "&>"):
            return False
        if token == ">&" and not (i >= 1 and tokens[i - 1] == "2" and i + 1 < len(tokens) and tokens[i + 1] in ("1", "2")):
            return False
        if token in ("-exec", "-execdir", "-delete", "-ok", "-okdir", "--exec"):
            return False
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", token):
            return False
    for segment in segments:
        words = [t.lower() for t in segment]
        if any(c in segment[0] for c in "*?{["):
            return False
        command = os.path.basename(words[0])
        if command in BLOCKED_COMMANDS or command.startswith("mkfs."):
            return False
        if command == "sort":
            for raw in segment[1:]:
                low = raw.lower()
                if low in ("--compress-program", "--files0-from", "--temporary-directory", "--output", "-o") or raw == "-T":
                    return False
                if low.startswith(("--compress-program=", "--files0-from=", "--temporary-directory=", "--output=")) or raw.startswith(("-T", "-o")):
                    return False
        if command == "ps":
            args = [x for x in words[1:] if not x.startswith("-")]
            if args and re.fullmatch(r"[a-z]*e[a-z]*", args[0]):
                return False
        if command in ("systemctl", "service"):
            args = [x for x in words[1:] if not x.startswith("-")]
            read_only = {"status", "show", "cat", "list-units", "list-unit-files", "list-timers", "list-sockets", "is-active", "is-enabled", "is-failed"}
            controlled = {"start", "stop", "restart", "reload", "try-restart", "reload-or-restart", "enable", "disable"}
            if not args:
                if words[1:] != ["--failed"]:
                    return False
            elif args[0] not in read_only:
                # Allow one named service operation; power operations use the dedicated route above.
                if (command != "systemctl" or args[0] not in controlled or len(args) != 2
                        or args[1] in {"reboot", "poweroff", "suspend"}
                        or not re.fullmatch(r"[a-zA-Z0-9_.@:-]+", args[1])):
                    return False
        if command in ("apt", "apt-get"):
            if not words[1:] or words[1] not in {"list", "show", "search", "policy"}:
                return False
        if command == "dpkg" and (not words[1:] or words[1] not in {"-l", "-L", "-s", "-S", "--list", "--listfiles", "--status", "--search", "--get-selections"}):
            return False
        if command == "git":
            if not words[1:] or words[1] not in {"status", "log", "diff", "show", "rev-parse", "ls-files", "describe", "blame", "shortlog"}:
                return False
            if any(x == "--output" or x.startswith("--output=") for x in words[2:]):
                return False
        if command == "date" and any(x.startswith("-") and x not in ("--help", "--version") for x in words[1:]):
            return False
        if command == "ip" and len(words) > 1:
            if words[1] in {"add", "del", "delete", "set", "flush", "change", "replace", "append", "prepend", "save", "restore", "exec", "netns", "tuntap", "tunnel", "up", "down"}:
                return False
            if len(words) > 2 and words[1] in {"link", "addr", "address", "route", "rule", "neigh"} and words[2] in {"add", "del", "delete", "set", "flush", "change", "replace"}:
                return False
        if command == "ss" and any(x == "-k" or x.startswith("-k") or x == "--kill" for x in words[1:]):
            return False
        if command == "dmesg" and any(x in {"-c", "--clear", "--read-clear", "-w", "--follow"} for x in words[1:]):
            return False
        if command == "nvidia-smi" and any(x in {"--gpu-reset", "-r", "--persistence-mode", "-pm", "--power-limit", "-pl", "--compute-mode", "-c", "--applications-clocks", "-ac"} for x in words[1:]):
            return False
        if command == "find" and any(x in words for x in ("-exec", "-execdir", "-delete", "-ok", "-okdir")):
            return False
        if command in ("awk", "gawk") and any(x in " ".join(words[1:]) for x in ("system(", "getline", "print >", "printf >")):
            return False
        if command == "sed" and any(x in words[1:] for x in ("-i", "--in-place", "-e", "--expression")):
            return False
    return True

