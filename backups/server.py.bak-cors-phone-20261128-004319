).split(os.pathsep) if p.strip()]
_WRITE_BLOCKED_PARTS = {".ssh", ".aws", ".config", ".gnupg", ".git", ".local", ".mozilla", "keyrings"}
_WRITE_BLOCKED_NAMES = {".env", ".netrc", ".bashrc", ".zshrc", ".profile", ".sentinel_memory.json",
                       "authorized_keys", "known_hosts", ".npmrc", ".pypirc", ".gitconfig"}

def _writable_path(raw_path):
    p = Path(raw_path).expanduser().resolve()
    name = p.name.lower()
    sensitive_name = (name.startswith(".env") or any(term in name for term in
                      ("password", "secret", "token", "credential", "cookie", "id_rsa", "id_ed25519", "private.key")))
    if sensitive_name or name in _WRITE_BLOCKED_NAMES or any(part.lower() in _WRITE_BLOCKED_PARTS for part in p.parts):
        raise HTTPException(403, "Writing to a protected path is not allowed.")
    if not any(p == root or root in p.parents for root in WRITE_ROOTS):
        raise HTTPException(403, "Write path is outside the configured Sentinel write roots.")
    return p

@app.post("/file/write", dependencies=[Depends(verify_key)])
def write_file(req: FileWriteReq):
    if len(req.content.encode("utf-8")) > 10 * 1024 * 1024:
        raise HTTPException(413, "File content exceeds the 10 MiB limit.")
    try:
        p = _writable_path(req.path)
        p.parent.mkdir(parents=True, exist_ok=True)
        # Resolve again after creating parents to ensure a symlink cannot redirect the write.
        p = _writable_path(str(p))
        p.write_text(req.content, encoding="utf-8")
        return {"path": str(p), "ok": True}
    except HTTPException:
        raise
    except Exception as e: raise HTTPException(500, f"File system write failure: {e}")

@app.get("/file/ls", dependencies=[Depends(verify_key)])
def list_dir(path: str = "~", show_hidden: bool = False):
    p = Path(path).expanduser().resolve()
    if not p.exists(): raise HTTPException(404, "Not found")
    if not p.is_dir(): raise HTTPException(400, "Not a directory")
    entries = []
    for item in sorted(p.iterdir()):
        if not show_hidden and item.name.startswith("."): continue
        try:
            st = item.stat()
            entries.append({"name":item.name,"type":"dir" if item.is_dir() else "file","size_bytes":st.st_size if item.is_file() else None,"modified":datetime.fromtimestamp(st.st_mtime).isoformat(),"permissions":oct(st.st_mode)[-3:]})
        except: pass
    return {"path":str(p),"entries":entries,"count":len(entries)}

def _sentinel_monitor_region():
    """Find the XRandR monitor containing the visible Sentinel V2 window."""
    xdotool, xwininfo, xrandr = shutil.which("xdotool"), shutil.which("xwininfo"), shutil.which("xrandr")
    if not all((xdotool, xwininfo, xrandr)):
        return None
    try:
        found = subprocess.run([xdotool, "search", "--onlyvisible", "--name", "Sentinel V2"], capture_output=True, text=True, timeout=3)
        monitors = subprocess.run([xrandr, "--listmonitors"], capture_output=True, text=True, timeout=3)
        if found.returncode != 0 or monitors.returncode != 0:
            return None
        windows = []
        for window_id in found.stdout.split():
            info = subprocess.run([xwininfo, "-id", window_id], capture_output=True, text=True, timeout=3)
            x = re.search(r"^\s*Absolute upper-left X:\s*(-?\d+)", info.stdout, re.MULTILINE)
            y = re.search(r"^\s*Absolute upper-left Y:\s*(-?\d+)", info.stdout, re.MULTILINE)
            w = re.search(r"^\s*Width:\s*(\d+)", info.stdout, re.MULTILINE)
            h = re.search(r"^\s*Height:\s*(\d+)", info.stdout, re.MULTILINE)
            if info.returncode == 0 and x and y and w and h:
                windows.append((int(x.group(1)), int(y.group(1)), int(w.group(1)), int(h.group(1))))
        if not windows:
            return None
        wx, wy, ww, wh = max(windows, key=lambda r: r[2] * r[3])
        cx, cy = wx + ww // 2, wy + wh // 2
        for line in monitors.stdout.splitlines():
            m = re.search(r"^\s*\d+:\s+\S+\s+(\d+)/\d+x(\d+)/\d+([+-]\d+)([+-]\d+)", line)
            if not m:
                continue
            mw, mh, mx, my = int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4))
            if mx <= cx < mx + mw and my <= cy < my + mh:
                return mx, my, mw, mh
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    return None

@app.get("/screenshot", dependencies=[Depends(verify_key)])
def take_screenshot(scope: str = ""):
    region = _sentinel_monitor_region() if scope == "sentinel" else None
    if scope == "sentinel" and region is None:
        raise HTTPException(503, "Could not locate the Sentinel V2 monitor for a desktop screenshot.")
    origin_x, origin_y = (region[0], region[1]) if region else (0, 0)
    desktop_width = desktop_height = None
    if region:
        xwininfo = shutil.which("xwininfo")
        if xwininfo:
            root_info = subprocess.run([xwininfo, "-root"], capture_output=True, text=True, timeout=3)
            wm = re.search(r"^\s*Width:\s*(\d+)", root_info.stdout, re.MULTILINE)
            hm = re.search(r"^\s*Height:\s*(\d+)", root_info.stdout, re.MULTILINE)
            if root_info.returncode == 0 and wm and hm:
                desktop_width, desktop_height = int(wm.group(1)), int(hm.group(1))
        if desktop_width is None or desktop_height is None:
            raise HTTPException(503, "Could not read full desktop dimensions.")
    with tempfile.TemporaryDirectory(prefix="sentinel-screenshot-") as temp_dir:
        out = Path(temp_dir) / "screenshot.png"
        if region:
            area = ",".join(str(v) for v in region)
            cmds = [["scrot", "-a", area, str(out)]]
            if shutil.which("import"):
                cmds.append(["import", "-window", "root", "-crop", f"{region[2]}x{region[3]}+{region[0]}+{region[1]}", str(out)])
        else:
            cmds = [["scrot", str(out)], ["gnome-screenshot", "-f", str(out)], ["import", "-window", "root", str(out)]]
        for cmd in cmds:
            try:
                r = subprocess.run(cmd, capture_output=True, timeout=10)
                if r.returncode == 0 and out.is_file() and out.stat().st_size:
                    image_bytes = out.read_bytes()
                    width = int.from_bytes(image_bytes[16:20], "big") if len(image_bytes) >= 24 else None
                    height = int.from_bytes(image_bytes[20:24], "big") if len(image_bytes) >= 24 else None
                    if region and (width != region[2] or height != region[3]):
                        raise HTTPException(500, "Captured monitor dimensions did not match the requested region.")
                    if not region:
                        desktop_width, desktop_height = width, height
                    return {"ok": True, "image_b64": base64.b64encode(image_bytes).decode(), "width": width, "height": height, "origin_x": origin_x, "origin_y": origin_y, "desktop_width": desktop_width, "desktop_height": desktop_height}
            except (FileNotFoundError, subprocess.TimeoutExpired):
                continue
    raise HTTPException(500, "Screenshot failed. Please ensure a screenshot tool is installed.")

@app.get("/desktop/windows", dependencies=[Depends(verify_key)])
def desktop_windows():
