@app.post("/clipboard/set", dependencies=[Depends(verify_key)])
def set_clipboard(req: ClipboardReq):
    # No shell: the text goes in on stdin, so quotes or $(...) in it can never be run as a command.
    for cmd in (["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"], ["wl-copy"]):
        try:
            r = subprocess.run(cmd, input=req.text, text=True, timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if r.returncode == 0: return {"ok": True}
        except (FileNotFoundError, subprocess.TimeoutExpired): continue
    raise HTTPException(500, "Clipboard configuration failed.")

