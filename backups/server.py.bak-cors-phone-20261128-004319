# ── FIX: DYNAMIC USER UID PULSEAUDIO AUDIO PIPELINE ──
class TTSReq(BaseModel):
    text: str
    personality: str = "sentinel"

_tts_proc = None   # the paplay process of the last spoken reply, so a new one can cut it off
_tts_count = 0     # how many replies /tts has started (the voice follow-up uses it to see when a reply begins and ends)

def _cleanup_tts_file(proc, path):
    try:
        proc.wait(timeout=300)
    except subprocess.TimeoutExpired:
        proc.terminate()
        try: proc.wait(timeout=2)
        except subprocess.TimeoutExpired: proc.kill(); proc.wait()
    finally:
        try: Path(path).unlink(missing_ok=True)
        except OSError: pass

@app.post("/tts", dependencies=[Depends(verify_key)])
def tts(req: TTSReq):
    global _tts_proc, _tts_count
    tmpfile = None
    text = req.text
    text = re.sub(r'<ACTION>[\s\S]*?</ACTION>', '', text)
    text = re.sub(r'```[\s\S]*?```', 'code block', text)
    text = re.sub(r'`[^`]*`', '', text)
    text = re.sub(r'<[^>]*>', '', text)
    text = text.strip()[:500]
    if not text: return {"ok": False, "error": "Empty string string context post-cleaning processing."}
    
    try:
        with tempfile.NamedTemporaryFile(suffix=".wav", prefix="sentinel-tts-", delete=False) as tmp:
            tmpfile = tmp.name
        safe_text = text.replace('"', "'").replace('\\', '')
        festival_script = f'(voice_cmu_us_slt_arctic_hts)(utt.save.wave (utt.synth (Utterance Text "{safe_text}")) "{tmpfile}")'
        piper = [sys.executable, "-m", "piper"] if Path(sys.executable).parent.joinpath("piper").is_file() or __import__("importlib.util").util.find_spec("piper") else None
        piper_dir = Path(os.environ.get("SENTINEL_PIPER_DIR", str(Path.home() / "Desktop" / "OG_Drive" / "Models" / "piper" / "voices"))).expanduser()
        personality = req.personality.lower() if req.personality.lower() in PERSONALITIES else "sentinel"
        piper_voice = {"sentinel":"en_US-lessac-medium", "sayori":"en_US-amy-medium", "monika":"en_US-kristin-medium", "natsuki":"en_US-ljspeech-medium", "subaru":"en_US-ryan-medium", "beatrice":"en_US-hfc_female-medium", "reinhard":"en_US-norman-medium", "regulus":"en_US-john-medium", "thomas":"en_US-hfc_male-medium"}[personality]
        piper_model = piper_dir / (piper_voice + ".onnx")
        if piper and piper_model.is_file():
            subprocess.run(piper + ["--model", str(piper_model), "--output_file", tmpfile], input=text, text=True, capture_output=True, timeout=45)
        else:
            subprocess.run(['festival', '--pipe'], input=festival_script, text=True, capture_output=True, timeout=15)
        
        if os.path.exists(tmpfile) and os.path.getsize(tmpfile) > 0:
            # Dynamically determine executing user's UID profile bounds instead of assuming 1000
            user_uid = os.getuid()
            env = {**os.environ}
            env['XDG_RUNTIME_DIR'] = f'/run/user/{user_uid}'
            env['PULSE_RUNTIME_PATH'] = f'/run/user/{user_uid}/pulse'
            env['PULSE_SERVER'] = f'unix:/run/user/{user_uid}/pulse/native'
            
            if _tts_proc and _tts_proc.poll() is None:
                _tts_proc.terminate()
            _tts_proc = subprocess.Popen(["paplay", tmpfile], env=env)
            threading.Thread(target=_cleanup_tts_file, args=(_tts_proc, tmpfile), daemon=True).start()
            tmpfile = None  # the cleanup thread now owns the temporary file
            _tts_count += 1
            return {"ok": True}
        return {"ok": False, "error": "Speech synthesis did not create an audio file."}
    except Exception as e:
        print(f"[Audio Link Engine Failure]: {e}")
        return {"ok": False, "error": str(e)}
    finally:
        if tmpfile:
            try: Path(tmpfile).unlink(missing_ok=True)
            except OSError: pass

