<script>
var msgsEl=document.getElementById('msgs');
var textarea=document.getElementById('textarea');
var sendBtn=document.getElementById('sendBtn');
var stL=document.getElementById('st-l');
var stR=document.getElementById('st-r');
var pulse=document.getElementById('pulse');
var micBtn=document.getElementById('micBtn');
var ttsBtn=document.getElementById('ttsBtn');

var chatHistory=[];
var sessions=JSON.parse(localStorage.getItem('sentinel_sessions')||'[]');
var currentMode='assistant';
var currentPersonality=(function(){try{return localStorage.getItem('sentinel_personality')||'sentinel';}catch(e){return 'sentinel';}})();
var personalityDocs={};
var attached=null;
var recog=null;
var recording=false;
var voicePollInterval=null;
var ttsEnabled=false;
var graphData={cpu:[],mem:[],gpu:[]};
var MAX_PTS=40;
var availableModels=[];

var MODEL_ROUTES={vision:'moondream:latest',code:'codellama',default:'mistral',persona:'llama3.1:8b'};

// Auto-detect host — if accessed from another device, use that device's IP
   var API_KEY = '';
   try{ API_KEY = (localStorage.getItem('sentinel_api_key')||'').trim(); }catch(e){}

   // In-page API key popup (window.prompt does not work inside Electron).
   // Shown only when no key is stored; checks the key against the backend before saving.
   function showKeyModal(){
     if(document.getElementById('keyModal')) return;
     var st=document.createElement('style');
     st.textContent=
       '#keyModal{position:fixed;top:0;left:0;right:0;bottom:0;z-index:99999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.82);}'+
       '#keyModal .km-box{width:min(420px,90vw);background:var(--bg1);border:1px solid var(--border2);border-radius:12px;padding:22px 22px 18px;box-shadow:0 20px 60px rgba(0,0,0,.6);}'+
       '#keyModal .km-title{font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.2em;color:var(--text);margin-bottom:6px;}'+
       '#keyModal .km-sub{font-size:12.5px;color:var(--text2);line-height:1.5;margin-bottom:14px;}'+
       '#keyModal .km-row{display:flex;gap:8px;}'+
       '#keyModal input{flex:1;min-width:0;font-family:var(--mono);font-size:12px;background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text);padding:0 10px;height:34px;outline:none;}'+
       '#keyModal input:focus{border-color:var(--accent2);}'+
       '#keyModal button{font-family:var(--mono);font-size:11px;background:transparent;border:1px solid var(--border2);border-radius:6px;color:var(--text2);padding:0 12px;height:34px;cursor:pointer;}'+
       '#keyModal button:hover{color:var(--text);border-color:#3a3a3a;}'+
       '#keyModal #kmGo{color:var(--accent);border-color:var(--accent2);}'+
       '#keyModal #kmGo:disabled{opacity:.5;cursor:default;}'+
       '#keyModal .km-err{min-height:16px;margin-top:10px;font-family:var(--mono);font-size:11px;color:#f87171;}';
     document.head.appendChild(st);
     var m=document.createElement('div');
     m.id='keyModal';
     m.innerHTML=
       '<div class="km-box">'+
         '<div class="km-title">SENTINEL V2</div>'+
         '<div class="km-sub">No API key is saved on this device. Enter it to connect to the Sentinel backend.</div>'+
         '<div class="km-row">'+
           '<input id="kmInput" type="password" placeholder="API key" autocomplete="off" spellcheck="false" />'+
           '<button id="kmShow" type="button">Show</button>'+
           '<button id="kmGo" type="button">Connect</button>'+
         '</div>'+
         '<div class="km-err" id="kmErr"></div>'+
       '</div>';
     document.body.appendChild(m);
     var inp=document.getElementById('kmInput'), err=document.getElementById('kmErr'),
         go=document.getElementById('kmGo'), sh=document.getElementById('kmShow');
     sh.onclick=function(){
       var hidden=inp.type==='password';
       inp.type=hidden?'text':'password';
       sh.textContent=hidden?'Hide':'Show';
     };
     function submit(){
       var k=inp.value.trim();
       if(!k){ err.style.color='#f87171'; err.textContent='Enter the key first.'; return; }
       go.disabled=true; err.style.color='var(--text2)'; err.textContent='Checking key...';
       var base=''; try{ base=backend(); }catch(e){}
       fetch(base+'/system/info',{headers:{'X-Api-Key':k}}).then(function(r){
         if(r.status===401||r.status===403){
           err.style.color='#f87171'; err.textContent='The backend rejected that key.'; go.disabled=false; return;
         }
         if(!r.ok){
           err.style.color='#f87171'; err.textContent='Backend answered with status '+r.status+'. Key not saved.'; go.disabled=false; return;
         }
         try{ localStorage.setItem('sentinel_api_key',k); }catch(e){}
         err.style.color='var(--text2)'; err.textContent='Connected. Loading...';
         location.reload();
       }).catch(function(){
         err.style.color='#f87171'; err.textContent='Could not reach the backend at '+base+'. Is it running?'; go.disabled=false;
       });
     }
     go.onclick=submit;
     inp.addEventListener('keydown',function(e){ if(e.key==='Enter') submit(); });
     setTimeout(function(){ inp.focus(); },50);
   }
   if(!API_KEY) showKeyModal();

var _host = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1'
  ? window.location.hostname
  : 'localhost';

function ollama(){
  return backend()+'/api/ollama';
}
function backend(){
  var v = document.getElementById('backendUrl').value.trim().replace(/\/$/,'');
  return v.replace('localhost', _host).replace('127.0.0.1', _host);
}

// Authenticated fetch — always includes API key
function bfetch(url, opts) {
  opts = opts || {};
  opts.headers = opts.headers || {};
  opts.headers['X-Api-Key'] = API_KEY;
  return fetch(url, opts);
}
function ts(){return new Date().toLocaleTimeString('en-US',{hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit'});}

function pickModel(text,hasImage){
  if(hasImage) return MODEL_ROUTES.vision;
  if(typeof currentPersonality!=='undefined'&&currentPersonality!=='sentinel'){
    var pm=availableModels.find(function(m){return m.indexOf(MODEL_ROUTES.persona)===0;});
    if(pm) return pm;
  }
  var t=(text||'').toLowerCase();
  var isCode=/\b(code|script|function|debug|python|javascript|bash|write a|fix this|class|def |const |import )\b/.test(t);
  var cl=availableModels.find(function(m){return m.indexOf('codellama')===0;});
  if(isCode&&cl) return cl;
  return (document.getElementById('modelSel').value||MODEL_ROUTES.default);
}

function setActiveModel(name){
  var sel=document.getElementById('modelSel');
  var found=false;
  for(var i=0;i<sel.options.length;i++){if(sel.options[i].value===name){found=true;break;}}
  if(!found){var o=document.createElement('option');o.value=name;o.textContent=name;sel.appendChild(o);}
  sel.value=name;
  stR.textContent=name;
}

