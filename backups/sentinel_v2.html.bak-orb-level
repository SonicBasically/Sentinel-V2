function detectMode(text){
  var t=String(text||'');
  if(t.length<3) return null;
  var scores={};
  Object.keys(MODE_RULES).forEach(function(m){
    var s=0;
    MODE_RULES[m].forEach(function(r){
      // count distinct keyword hits per rule (capped at 3) so "restart the ollama service" beats a single weak word
      var hits=t.toLowerCase().match(new RegExp(r[0].source,'gi'));
      if(hits){var u={};hits.forEach(function(h){u[h]=1;});s+=r[1]*Math.min(Object.keys(u).length,3);}
    });
    scores[m]=s;
  });
  var best=null,bs=0,second=0;
  Object.keys(scores).forEach(function(m){
    if(scores[m]>bs){second=bs;bs=scores[m];best=m;}
    else if(scores[m]>second){second=scores[m];}
  });
  // Need a clear winner; otherwise stay in the current mode (keeps follow-ups like "yes do it" sticky)
  if(!best||bs<2||bs-second<1) return null;
  return best;
}

