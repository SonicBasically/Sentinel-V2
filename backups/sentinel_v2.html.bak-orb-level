// Spoken requests that are not simple commands: the backend hands them over (handoff:true) and they run through
// send() like typed ones. They queue, and wait for a typed request that is still running.
var _voiceQ=[],_voiceRunning=false;
function queueVoiceTurn(t){_voiceQ.push(t);runVoiceQueue();}
async function runVoiceQueue(){
  if(_voiceRunning) return;
  _voiceRunning=true;
  try{
    while(_voiceQ.length){
      var t=_voiceQ.shift();
      while(sendBtn.disabled) await new Promise(function(r){setTimeout(r,300);});
      try{ await send(t); }catch(e){ console.warn('voice request failed:',e); }
    }
  }finally{ _voiceRunning=false; }
}
// When the final reply to a spoken request has been spoken, tell the backend: if it asks a question, the mic opens.
async function voiceFollowUp(){
  var ls=_lastSpeak;
  if(!ls||!ls.text) return;
  try{ await ls.done; }catch(e){}
  try{
    await bfetch(backend()+'/api/voice/question',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reply:ls.text,spoken:ls.spoken})});
  }catch(e){}
}

function startVoicePolling(){
  if(voicePollInterval) return;
  voicePollInterval=setInterval(async function(){
    if(document.visibilityState==='hidden') return;   // a background tab should not grab the replies
    try{
      var r=await bfetch(backend()+'/api/voice/last_response');
      if(!r.ok) return;
      var d=await r.json();
      applyWakeUI(d.wake);
      if(d.status==='new'){
        if(d.handoff){
          queueVoiceTurn(d.transcript);
        }else{
          addMsg('user',d.transcript);
          addMsg('ai',d.reply);
          speak(d.reply);
        }
      }
    }catch(e){
      /* silent: backend may just be busy */
    }
  },1000);
}

