<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Sentinel V2</title>
<link rel="manifest" href="manifest.json" />
<meta name="theme-color" content="#080808" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Sentinel" />
<meta name="mobile-web-app-capable" content="yes" />
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg:#080808;--bg1:#0f0f0f;--bg2:#161616;--bg3:#1e1e1e;
  --border:#1e1e1e;--border2:#2a2a2a;
  --text:#e2e2e2;--text2:#a8a8a8;--text3:#888888;
  --accent:#c084fc;--accent2:#a855f7;
  --green:#4ade80;--red:#f87171;--yellow:#fbbf24;--blue:#60a5fa;
  --mono:'JetBrains Mono','Fira Code',monospace;
  --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:var(--sans);}
#shell{display:grid;grid-template-rows:auto auto 1fr;height:100vh;height:100dvh;width:100vw;overflow:hidden;}
#topbar{display:flex;align-items:center;gap:10px;padding:0 18px;height:50px;background:var(--bg1);border-bottom:1px solid var(--border);flex-shrink:0;}
.logo{font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:0.2em;color:var(--text);display:flex;align-items:center;gap:9px;white-space:nowrap;margin-right:auto;}
.pulse{width:7px;height:7px;border-radius:50%;background:var(--text3);flex-shrink:0;transition:color 0.4s,background-color 0.4s,border-color 0.4s,box-shadow 0.4s,opacity 0.4s,transform 0.4s;}
.pulse.on{background:var(--green);box-shadow:0 0 8px #4ade8055;}
.pulse.err{background:var(--red);}
.tb-in{font-family:var(--mono);font-size:11px;background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text);padding:4px 9px;height:28px;outline:none;}
#modelSel{width:125px;cursor:pointer;}#backendUrl{width:150px;}
.tb-sep{width:1px;height:18px;background:var(--border2);flex-shrink:0;}
.tb-btn{font-family:var(--mono);font-size:11px;background:transparent;border:1px solid var(--border2);border-radius:6px;color:var(--text2);padding:0 11px;height:28px;cursor:pointer;white-space:nowrap;transition:color 0.15s,background-color 0.15s,border-color 0.15s,box-shadow 0.15s,opacity 0.15s,transform 0.15s;}
.tb-btn:hover{color:var(--text);border-color:#3a3a3a;}
.tb-btn.active{color:var(--accent);border-color:var(--accent2);}
#sysbar{display:grid;grid-template-columns:repeat(8,1fr);gap:6px;padding:7px 18px;background:var(--bg1);border-bottom:1px solid var(--border);flex-shrink:0;}
.sc{background:var(--bg2);border:1px solid var(--border);border-radius:7px;padding:6px 9px;}
.sc-click{cursor:pointer;transition:border-color 0.15s;}
.sc-click:hover{border-color:var(--accent2);}
.sc-v.dev-ok{color:var(--green);}.sc-v.dev-bad{color:var(--text2);}
.sc-l{font-family:var(--mono);font-size:11px;color:var(--text3);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:3px;}
.sc-v{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sc-b{height:2px;background:var(--border2);border-radius:1px;margin-top:4px;overflow:hidden;}
.sc-f{height:100%;border-radius:1px;background:var(--text2);transition:width 0.5s,background 0.5s;}
.sc-f.warn{background:var(--yellow);}.sc-f.crit{background:var(--red);}
#main{display:grid;grid-template-columns:250px 1fr 236px;overflow:hidden;min-height:0;}
#sidebar{background:var(--bg1);border-right:1px solid var(--border);display:grid;grid-template-columns:44px 1fr;overflow:hidden;min-height:0;}
#sidebar-tabs{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 0;border-right:1px solid var(--border);}
.stab{width:36px;height:44px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:0;color:var(--text2);cursor:pointer;border:none;background:none;border-radius:8px;transition:color 0.15s,background-color 0.15s,border-color 0.15s,box-shadow 0.15s,opacity 0.15s,transform 0.15s;}
.stab:hover{color:var(--text);background:var(--bg2);}.stab.active{color:var(--accent);background:var(--bg2);}
.stab-ic{font-size:16px;line-height:1;}
.stab-lb{font-family:var(--mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;}
#sb-main{display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;}
#sb-top{display:flex;flex-direction:column;gap:8px;padding:10px;border-bottom:1px solid var(--border);flex-shrink:0;}
#sb-panels{display:flex;flex-direction:column;flex:1;min-height:0;overflow:hidden;}
.sidebar-panel{display:none;flex-direction:column;flex:1;overflow-y:auto;overflow-x:hidden;}
.sidebar-panel.show{display:flex;}
.sidebar-panel::-webkit-scrollbar{width:3px;}
.sidebar-panel::-webkit-scrollbar-thumb{background:var(--border2);}
.sb-sec{padding:12px 12px 5px;font-family:var(--mono);font-size:11px;color:var(--text3);letter-spacing:0.12em;text-transform:uppercase;}
.sb-btn{display:flex;align-items:center;gap:8px;padding:7px 12px;font-family:var(--mono);font-size:11px;color:var(--text2);cursor:pointer;background:none;border:none;width:100%;text-align:left;transition:color 0.1s,background-color 0.1s,border-color 0.1s,box-shadow 0.1s,opacity 0.1s,transform 0.1s;}
.sb-btn:hover{background:var(--bg2);color:var(--text);}
.sb-btn .ic{font-size:11px;width:13px;text-align:center;flex-shrink:0;}
.sb-div{margin:5px 12px;border:none;border-top:1px solid var(--border);}
body{--mode:var(--accent);}
.mode-sec{display:flex;align-items:center;justify-content:space-between;}
.auto-toggle{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:11px;letter-spacing:0.12em;padding:2px 8px;border-radius:999px;border:1px solid var(--border2);background:none;color:var(--text2);cursor:pointer;transition:color 0.18s,background-color 0.18s,border-color 0.18s,box-shadow 0.18s,opacity 0.18s,transform 0.18s;}
.auto-toggle:hover{color:var(--text);}
.auto-dot{width:5px;height:5px;border-radius:50%;background:var(--text3);transition:color 0.2s,background-color 0.2s,border-color 0.2s,box-shadow 0.2s,opacity 0.2s,transform 0.2s;}
.auto-toggle.on{color:var(--mode);border-color:var(--mode);}
.auto-toggle.on .auto-dot{background:var(--mode);box-shadow:0 0 6px var(--mode);}
.mode-btn{--mc:var(--accent);position:relative;display:flex;align-items:center;gap:10px;padding:8px 10px;margin:3px 10px;width:calc(100% - 20px);font-family:var(--mono);color:var(--text2);cursor:pointer;background:var(--bg1);border:1px solid var(--border);border-radius:8px;text-align:left;transition:color 0.18s,background-color 0.18s,border-color 0.18s,box-shadow 0.18s,opacity 0.18s,transform 0.18s;overflow:hidden;}
.mode-btn[data-mode=assistant]{--mc:var(--accent);}
.mode-btn[data-mode=sysadmin]{--mc:#fbbf24;}
.mode-btn[data-mode=developer]{--mc:#60a5fa;}
.mode-btn[data-mode=security]{--mc:#f87171;}
.mode-btn::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--mc);opacity:0;transition:opacity 0.18s;}
.mode-btn:hover{background:var(--bg2);color:var(--text);border-color:var(--border2);}
.mode-btn.active{color:var(--text);border-color:var(--mc);background:linear-gradient(90deg,rgba(255,255,255,0.05),transparent 80%);box-shadow:0 0 14px -5px var(--mc);}
.mode-btn.active::before{opacity:1;}
.mc-ic{width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:13px;background:var(--bg3);color:var(--mc);flex-shrink:0;transition:color 0.18s,background-color 0.18s,border-color 0.18s,box-shadow 0.18s,opacity 0.18s,transform 0.18s;}
.mode-btn.active .mc-ic{background:var(--mc);color:#0a0a0a;}
.mc-txt{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1;}
.mc-name{font-size:11px;font-weight:600;letter-spacing:0.02em;}
.mc-desc{font-size:11px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mc-flag{font-size:11px;letter-spacing:0.12em;color:var(--mc);flex-shrink:0;}
.mode-btn.pulse{animation:modePulse 0.7s ease-out;}
@keyframes modePulse{0%{box-shadow:0 0 0 0 var(--mc);}100%{box-shadow:0 0 0 12px transparent;}}
.mode-badge{display:flex;align-items:center;gap:7px;height:26px;padding:0 10px;border-radius:999px;border:1px solid var(--mode);background:var(--bg2);font-family:var(--mono);font-size:11px;color:var(--text);cursor:pointer;flex-shrink:0;transition:color 0.25s,background-color 0.25s,border-color 0.25s,box-shadow 0.25s,opacity 0.25s,transform 0.25s;box-shadow:0 0 12px -6px var(--mode);}
.mode-badge #mbIc{color:var(--mode);font-size:12px;}
.mode-badge .mb-auto{font-size:11px;letter-spacing:0.12em;color:var(--mode);border-left:1px solid var(--border2);padding-left:7px;}
#topbar{position:relative;}
#topbar::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:1px;background:linear-gradient(90deg,transparent,var(--mode),transparent);opacity:0.55;pointer-events:none;transition:color 0.3s,background-color 0.3s,border-color 0.3s,box-shadow 0.3s,opacity 0.3s,transform 0.3s;}
.mode-note{display:flex;align-items:center;gap:7px;width:fit-content;align-self:center;margin:8px auto;padding:4px 12px;font-family:var(--mono);font-size:11px;color:var(--text2);border:1px solid var(--border2);border-radius:999px;background:var(--bg1);animation:modeNoteIn 0.35s ease-out;}
.mode-note .mn-ic{color:var(--mc);}
.mode-note b{color:var(--mc);font-weight:600;}
.mode-note .mn-auto{font-size:11px;letter-spacing:0.12em;color:var(--text3);border-left:1px solid var(--border2);padding-left:7px;}
@keyframes modeNoteIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
.sb-modehead{display:flex;align-items:center;justify-content:space-between;gap:8px;}
.sb-modelabel{font-family:var(--mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--mode);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mode-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;}
.mode-grid .mode-btn{margin:0;width:auto;padding:0;height:36px;justify-content:center;gap:0;border-radius:8px;}
.mode-grid .mc-txt,.mode-grid .mc-flag{display:none;}
.mode-grid .mc-ic{width:100%;height:100%;border-radius:0;background:transparent;font-size:14px;}
.mode-grid .mode-btn.active .mc-ic{background:var(--mc);color:#0a0a0a;}
#sb-search{display:flex;align-items:center;gap:6px;height:30px;padding:0 8px;background:var(--bg2);border:1px solid var(--border2);border-radius:8px;transition:border-color 0.15s;cursor:text;}
#sb-search:focus-within{border-color:var(--accent);}
.sb-sic{color:var(--text3);font-size:13px;}
#cmdSearch{flex:1;min-width:0;background:none;border:none;outline:none;color:var(--text);font-family:var(--mono);font-size:11px;}
#cmdSearch::placeholder{color:var(--text3);}
.sb-kbd{font-family:var(--mono);font-size:11px;color:var(--text3);border:1px solid var(--border2);border-radius:4px;padding:0 5px;line-height:15px;}
#cmdSearch:not(:placeholder-shown)~.sb-kbd{display:none;}
#cmdSearchClear{display:none;background:none;border:none;color:var(--text2);font-size:15px;line-height:1;cursor:pointer;padding:0 2px;}
#cmdSearch:not(:placeholder-shown)~#cmdSearchClear{display:block;}
.sb-grp .sb-sec{padding-top:10px;}
.sb-nores{padding:14px 12px;font-family:var(--mono);font-size:11px;color:var(--text3);}
@media(max-width:768px){.sb-btn{padding:10px 12px;font-size:12px;}.mode-grid .mode-btn{height:42px;}#sb-search{height:38px;}#cmdSearch{font-size:16px;}.sb-kbd{display:none;}}
.g-sys{--gc:#c084fc;}.g-net{--gc:#60a5fa;}.g-tools{--gc:#4ade80;}
.sb-grp .sb-btn .ic{width:18px;height:18px;display:flex;align-items:center;justify-content:center;color:var(--gc);opacity:0.85;transition:opacity 0.1s;}
.sb-grp .sb-btn:hover .ic{opacity:1;}
.ico{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
@media(max-width:768px){.mode-badge{display:none;}}
.hist-item{padding:8px 12px;font-family:var(--mono);font-size:11px;color:var(--text2);cursor:pointer;border-bottom:1px solid var(--border);transition:color 0.1s,background-color 0.1s,border-color 0.1s,box-shadow 0.1s,opacity 0.1s,transform 0.1s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.hist-item:hover{background:var(--bg2);color:var(--text);}
.hist-item .hi-time{font-size:11px;color:var(--text3);margin-bottom:2px;}
#dashboard{padding:10px 12px;display:flex;flex-direction:column;gap:8px;}
.dash-card{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;}
.dash-title{font-family:var(--mono);font-size:11px;color:var(--text3);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:8px;}
.dash-graph{height:50px;position:relative;overflow:hidden;}
.dash-graph canvas{width:100%;height:100%;}
#chat{display:flex;flex-direction:column;overflow:hidden;min-height:0;background:var(--bg);position:relative;}
#panel-overlay{display:none;position:absolute;inset:0;background:rgba(8,8,8,0.97);z-index:40;flex-direction:column;padding:20px;gap:12px;overflow-y:auto;}
#panel-overlay.show{display:flex;}
.dev-row{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;font-family:var(--mono);font-size:12px;}
.dev-row .dev-dot{width:9px;height:9px;border-radius:50%;background:var(--text2);flex-shrink:0;}
.dev-row.on .dev-dot{background:var(--green);box-shadow:0 0 8px #4ade8055;}
.dev-row.off{opacity:0.55;}
.dev-name{color:var(--text);font-weight:600;}
.dev-name em{color:var(--accent);font-style:normal;font-weight:400;font-size:11px;}
.dev-meta{margin-left:auto;color:var(--text2);font-size:11px;}
.dev-empty{font-family:var(--mono);font-size:12px;color:var(--text2);}
.game-top{display:flex;gap:8px;}
#game-q{flex:1;background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text);font-family:var(--mono);font-size:12px;padding:8px 10px;outline:none;}
#game-q:focus{border-color:var(--accent);}
.game-btn{background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text2);font-family:var(--mono);font-size:11px;letter-spacing:0.1em;padding:0 12px;cursor:pointer;}
.game-btn:hover{color:var(--text);border-color:var(--accent);}
#game-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;}
.game-card{cursor:pointer;background:var(--bg2);border:1px solid var(--border);border-radius:8px;overflow:hidden;transition:color 0.15s,background-color 0.15s,border-color 0.15s,box-shadow 0.15s,opacity 0.15s,transform 0.15s;font-family:var(--mono);display:flex;flex-direction:column;}
.game-card:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 6px 18px -8px var(--accent);}
.game-card.off{opacity:0.55;}
.game-art{position:relative;aspect-ratio:460/215;overflow:hidden;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,hsl(var(--h),45%,22%),hsl(calc(var(--h) + 40),45%,12%));}
.game-art .ltr{font-size:34px;font-weight:700;color:rgba(255,255,255,0.35);}
.game-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 0.3s;}
.game-art img.in{opacity:1;}
.game-art.k-portrait img{object-position:center 20%;}
.game-art.k-icon img{object-fit:contain;padding:16%;box-sizing:border-box;}
.game-foot{padding:8px 10px;}
.game-name{font-size:12px;color:var(--text);font-weight:600;line-height:1.3;}
.game-tag{font-size:11px;letter-spacing:0.12em;color:var(--text2);margin-top:4px;}
.game-choices{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;}
.game-pick{background:var(--bg2);border:1px solid var(--border2);border-radius:999px;color:var(--text);font-family:var(--mono);font-size:11px;padding:4px 12px;cursor:pointer;}
.game-pick:hover{border-color:var(--accent);color:var(--accent);}
.panel-header{display:flex;align-items:center;justify-content:space-between;}
.panel-title{font-family:var(--mono);font-size:13px;font-weight:600;color:var(--text);}
.panel-close{font-family:var(--mono);font-size:11px;color:var(--text2);cursor:pointer;background:none;border:1px solid var(--border2);border-radius:5px;padding:3px 8px;}
.panel-close:hover{color:var(--text);}
#ss-preview{max-width:100%;border-radius:8px;border:1px solid var(--border2);}
.theme-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;}
.theme-card{background:var(--bg2);border:1px solid var(--border2);border-radius:8px;padding:12px;cursor:pointer;transition:border-color 0.15s,box-shadow 0.15s,transform 0.15s;text-align:center;font-family:var(--mono);font-size:11px;color:var(--text);}
.theme-card:hover{border-color:var(--accent);transform:translateY(-1px);}
.theme-card.active{border-color:var(--accent);box-shadow:0 0 10px -3px var(--accent);}
.theme-swatch{height:32px;border-radius:5px;margin-bottom:8px;border:1px solid rgba(255,255,255,0.08);}
#msgs{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:18px;display:flex;flex-direction:column;gap:14px;}
#msgs::-webkit-scrollbar{width:3px;}
#msgs::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
.msg{display:flex;flex-direction:column;gap:4px;max-width:87%;}
.msg.user{align-self:flex-end;align-items:flex-end;}
.msg.ai{align-self:flex-start;align-items:flex-start;}
.bubble{font-size:13px;line-height:1.7;padding:10px 14px;border-radius:12px;word-break:break-word;white-space:pre-wrap;}
.msg.user .bubble{background:var(--bg3);border:1px solid var(--border2);border-bottom-right-radius:3px;}
.msg.ai .bubble{background:var(--bg1);border:1px solid var(--border);border-bottom-left-radius:3px;}
.bubble code{font-family:var(--mono);font-size:11.5px;background:var(--bg3);border:1px solid var(--border2);border-radius:4px;padding:1px 5px;}
.bubble pre{font-family:var(--mono);font-size:11.5px;background:var(--bg);border:1px solid var(--border2);border-radius:8px;padding:11px 13px;margin:7px 0;overflow-x:auto;white-space:pre;line-height:1.5;}
.bubble pre code{background:none;border:none;padding:0;}
.msg-meta{font-family:var(--mono);font-size:11px;color:var(--text3);padding:0 2px;}
.chat-screenshot{max-width:100%;border-radius:8px;border:1px solid var(--border2);margin-top:4px;cursor:pointer;}
.typing{display:flex;gap:5px;align-items:center;padding:10px 14px;background:var(--bg1);border:1px solid var(--border);border-radius:12px;border-bottom-left-radius:3px;width:fit-content;}
.typing span{width:5px;height:5px;border-radius:50%;background:var(--text3);animation:blink 1.3s infinite;}
.typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,80%,100%{opacity:0.2;transform:scale(1)}40%{opacity:1;transform:scale(1.2)}}
.sys-block{font-family:var(--mono);font-size:11px;background:var(--bg1);border:1px solid var(--border);border-radius:10px;padding:11px 13px;color:var(--text2);max-width:540px;overflow-x:auto;}
#drop-ov{display:none;position:absolute;inset:0;background:rgba(8,8,8,0.92);z-index:50;flex-direction:column;align-items:center;justify-content:center;gap:10px;font-family:var(--mono);font-size:13px;color:var(--text2);border:1px dashed var(--border2);margin:14px;border-radius:12px;}
#drop-ov.show{display:flex;}
#confirm-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:999;align-items:center;justify-content:center;}
#confirm-modal.show{display:flex;}
.confirm-box{background:#0f0f0f;border:1px solid #2a2a2a;border-radius:14px;padding:28px 30px;max-width:440px;width:90%;font-family:var(--mono);}
.confirm-icon{font-size:24px;margin-bottom:10px;}
.confirm-title{font-size:14px;color:var(--text);font-weight:600;margin-bottom:6px;}
.confirm-detail{font-size:11px;color:#888;background:#0a0a0a;border:1px solid #1e1e1e;border-radius:7px;padding:9px 11px;margin:10px 0;word-break:break-all;max-height:100px;overflow-y:auto;}
.confirm-btns{display:flex;gap:10px;margin-top:18px;}
.confirm-yes{flex:1;padding:9px;border-radius:7px;border:1px solid var(--green);background:transparent;color:var(--green);font-family:var(--mono);font-size:11px;cursor:pointer;letter-spacing:0.08em;}
.confirm-no{flex:1;padding:9px;border-radius:7px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-family:var(--mono);font-size:11px;cursor:pointer;}
#save-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:999;align-items:center;justify-content:center;}
#save-modal.show{display:flex;}
#inputbar{flex-shrink:0;border-top:1px solid var(--border);background:var(--bg1);padding:10px 18px 12px;display:flex;flex-direction:column;gap:7px;}
#file-chip{display:none;align-items:center;gap:7px;padding:4px 9px;background:var(--bg2);border:1px solid var(--border2);border-radius:5px;font-family:var(--mono);font-size:11px;color:var(--text2);}
#file-chip.show{display:flex;}
#file-chip .fname{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text);}
#file-chip .rm{cursor:pointer;color:var(--text3);}#file-chip .rm:hover{color:var(--text);}
#input-row{display:flex;gap:7px;align-items:flex-end;}
#textarea{flex:1;background:var(--bg2);border:1px solid var(--border2);border-radius:10px;padding:9px 13px;font-size:13px;font-family:var(--sans);color:var(--text);resize:none;min-height:40px;max-height:120px;line-height:1.5;outline:none;transition:border-color 0.15s;}
#textarea:focus{border-color:#2e2e2e;}
#textarea::placeholder{color:var(--text3);}
.ibt{width:40px;height:40px;border-radius:9px;border:1px solid var(--border2);background:var(--bg2);color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;transition:color 0.15s,background-color 0.15s,border-color 0.15s,box-shadow 0.15s,opacity 0.15s,transform 0.15s;}
.ibt:hover{color:var(--text);border-color:#3a3a3a;}
.ibt:disabled{opacity:0.3;cursor:not-allowed;}
.ibt.send{background:var(--bg3);border-color:#2e2e2e;color:var(--text);}
.ibt.send:hover{background:#222;}
.ibt.rec{color:var(--red);border-color:var(--red);background:#140a0a;animation:rpulse 1s infinite;}
.ibt.wake{color:var(--green);border-color:#1f5a35;}
.ibt.tts-on{color:var(--accent);border-color:var(--accent2);}
@keyframes rpulse{0%,100%{opacity:1}50%{opacity:0.6}}
#statusbar{display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;color:var(--text3);}
select option{background:#161616;}
/* ── MOBILE RESPONSIVE ── */
@media (max-width: 768px) {
  #topbar {
    padding: 0 10px;
    height: 46px;
    gap: 6px;
    flex-wrap: nowrap;
    overflow-x: auto;
  }
  .logo { font-size:11px; letter-spacing: 0.12em; }
  #backendUrl { display: none; }
  #modelSel { width: 100px; font-size:11px; }
  .tb-sep { display: none; }
  .tb-btn { font-size:11px; padding: 0 7px; height: 26px; }

  #sysbar {
    grid-template-columns: repeat(3, 1fr);
    padding: 5px 10px;
    gap: 4px;
  }
  #sysbar .sc:nth-child(5),
  #sysbar .sc:nth-child(6) { display: none; }
  .sc-v { font-size: 11px; }
  .sc-l { font-size:11px; }

  #main { grid-template-columns: 1fr; }

  #sidebar {
    display: none;
    position: fixed;
    right: 0; top: 0; bottom: 0;
    width: 280px;
    z-index: 200;
    border-left: 1px solid var(--border);
    box-shadow: -4px 0 20px rgba(0,0,0,0.8);
  }
  #sidebar.mobile-open { display: grid; }

  #sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 199;
  }
  #sidebar-overlay.show { display: block; }

  #chat { width: 100%; }

  #msgs { padding: 12px 10px; gap: 10px; }
  .msg { max-width: 95%; }
  .bubble { font-size: 13px; padding: 9px 12px; }

  #inputbar { padding: 8px 10px 10px; gap: 5px; }
  #input-row { gap: 5px; }
  #textarea { font-size: 13px; padding: 8px 10px; }
  .ibt { width: 38px; height: 38px; font-size: 15px; }

  /* Mobile menu button */
  #mobile-menu-btn {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 28px;
    border: 1px solid var(--border2);
    border-radius: 6px;
    background: var(--bg2);
    color: var(--text2);
    cursor: pointer;
    font-size: 14px;
    flex-shrink: 0;
  }
}

@media (min-width: 769px) {
  #mobile-menu-btn { display: none !important; }
  #sidebar-overlay { display: none !important; }
}

/* ── SAVED CHATS (left panel); command sidebar now sits on the right ── */
#chathist{grid-column:1;grid-row:1;background:var(--bg1);border-right:1px solid var(--border);display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;}
#chat{grid-column:2;grid-row:1;}
#sidebar{grid-column:3;grid-row:1;border-right:none;border-left:1px solid var(--border);}
#ch-top{display:flex;flex-direction:column;gap:8px;padding:10px;flex-shrink:0;}
#ch-new{display:flex;align-items:center;gap:8px;height:34px;padding:0 10px;font-family:var(--mono);font-size:12px;color:var(--text);background:var(--bg2);border:1px solid var(--border2);border-radius:8px;cursor:pointer;transition:border-color 0.15s,color 0.15s;}
#ch-new:hover{border-color:var(--accent2);color:var(--accent);}
.ch-plus{font-size:16px;line-height:1;color:var(--accent);}
#ch-search{display:flex;align-items:center;gap:6px;height:30px;padding:0 8px;background:var(--bg2);border:1px solid var(--border2);border-radius:8px;transition:border-color 0.15s;cursor:text;}
#ch-search:focus-within{border-color:var(--accent);}
#chatSearch{flex:1;min-width:0;background:none;border:none;outline:none;color:var(--text);font-family:var(--mono);font-size:12px;}
#chatSearch::placeholder{color:var(--text3);}
#chatSearchClear{display:none;background:none;border:none;color:var(--text2);font-size:15px;line-height:1;cursor:pointer;padding:0 2px;}
#chatSearch:not(:placeholder-shown)~#chatSearchClear{display:block;}
#ch-div{height:1px;background:var(--border);margin:0 10px 6px;flex-shrink:0;}
#ch-list{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding-bottom:10px;}
#ch-list::-webkit-scrollbar{width:3px;}
.ch-item{display:flex;align-items:center;gap:4px;min-height:36px;margin:1px 8px;padding:0 4px 0 10px;border-radius:8px;border:1px solid transparent;color:var(--text2);font-size:12.5px;cursor:pointer;transition:background-color 0.1s,color 0.1s,border-color 0.1s;}
.ch-item:hover{background:var(--bg2);color:var(--text);}
.ch-item.active{background:var(--bg2);color:var(--text);border-color:var(--border2);}
.ch-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px;padding:7px 0;}
.ch-title{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ch-snip{font-family:var(--mono);font-size:11px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ch-act{display:none;gap:2px;flex-shrink:0;}
.ch-item:hover .ch-act,.ch-item:focus-within .ch-act,.ch-item:has(.ch-ib.confirm) .ch-act{display:flex;}
.ch-item.editing .ch-act{display:none;}
.ch-ib{min-width:26px;height:26px;display:flex;align-items:center;justify-content:center;background:none;border:none;border-radius:6px;color:var(--text2);font-size:13px;cursor:pointer;}
.ch-ib:hover{background:var(--bg3);color:var(--text);}
.ch-ib.confirm{padding:0 8px;font-family:var(--mono);font-size:11px;color:#f87171;}
.ch-edit{flex:1;min-width:0;height:26px;margin:4px 0;padding:0 6px;font:inherit;background:var(--bg);border:1px solid var(--accent);border-radius:6px;color:var(--text);outline:none;}
@media (hover:none){.ch-act{display:flex;}}
#mobile-cmd-btn{display:none;}
@media (min-width:769px) and (max-width:1000px){#main{grid-template-columns:200px 1fr 200px;}}
@media (min-width:769px){#mobile-cmd-btn{display:none !important;}}
@media (max-width:768px){
  #chat{grid-column:1;}
  #sidebar{left:auto;right:0;border-left:1px solid var(--border);box-shadow:-4px 0 20px rgba(0,0,0,0.8);}
  #chathist{display:none;position:fixed;left:0;top:0;bottom:0;width:min(300px,86vw);z-index:200;box-shadow:4px 0 20px rgba(0,0,0,0.8);}
  #chathist.mobile-open{display:flex;}
  #mobile-cmd-btn{display:flex;align-items:center;justify-content:center;width:32px;height:28px;min-width:44px;min-height:44px;border:1px solid var(--border2);border-radius:6px;background:var(--bg2);color:var(--text2);cursor:pointer;font-size:14px;flex-shrink:0;}
  #ch-new,#ch-search{height:44px;}
  #chatSearch{font-size:16px;}
  .ch-item{min-height:44px;}
  .ch-ib{min-width:44px;height:44px;}
}

/* Safe area for notches */
@supports (padding: max(0px)) {
  #inputbar { padding-bottom: max(12px, env(safe-area-inset-bottom)); }
  #topbar   { padding-top: max(0px, env(safe-area-inset-top)); }
}


/* ── MEDIA PLAYER (bottom bar + expandable panel) ── */
#mp-audio{display:none;}
#mp-panel{display:none;flex:1;min-height:0;flex-direction:column;background:var(--bg);border-top:1px solid var(--border);}
#chat.mp-open #mp-panel{display:flex;}
#chat.mp-open #msgs{flex:0 0 0;height:0;min-height:0;padding:0;overflow:hidden;visibility:hidden;}
#mp-bar{flex-shrink:0;display:flex;align-items:center;gap:10px;padding:8px 14px;background:var(--bg1);border-top:1px solid var(--border);position:relative;min-height:56px;}
#mp-prog{position:absolute;left:0;right:0;top:-6px;height:12px;cursor:pointer;z-index:2;}
#mp-prog::before{content:'';position:absolute;left:0;right:0;top:5px;height:3px;background:var(--border);}
#mp-prog i{position:absolute;left:0;top:5px;height:3px;width:0;background:var(--mode,var(--accent));}
.mp-art{position:relative;width:40px;height:40px;border-radius:6px;background:var(--bg2);border:1px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--text2);overflow:hidden;}
.mp-art svg{width:45%;height:45%;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;}
.mp-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
#mp-meta{flex:1;min-width:0;font-family:var(--mono);cursor:pointer;}
#mp-title{font-size:12px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#mp-sub{font-size:11px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;}
.mp-ctl{display:flex;align-items:center;gap:4px;}
.mp-b{background:none;border:1px solid transparent;border-radius:6px;color:var(--text2);width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;padding:0;}
.mp-b:hover{color:var(--text);border-color:var(--border2);}
.mp-b.on{color:var(--mode,var(--accent));}
.mp-b.main{color:var(--text);border-color:var(--border2);background:var(--bg2);}
.mp-b svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.mp-b svg.f{fill:currentColor;stroke:none;}
.mp-tabs{display:flex;gap:6px;padding:10px 14px 0;overflow-x:auto;flex-shrink:0;}
.mp-tab{background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text2);font-family:var(--mono);font-size:11px;letter-spacing:0.1em;padding:0 12px;height:30px;cursor:pointer;white-space:nowrap;flex-shrink:0;}
.mp-tab:hover{color:var(--text);}
.mp-tab.on{color:var(--text);border-color:var(--mode,var(--accent));}
#mp-body{flex:1;min-height:0;overflow-y:auto;padding:12px 14px;display:flex;flex-direction:column;gap:10px;}
.mp-row{display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;font-family:var(--mono);font-size:12px;content-visibility:auto;contain-intrinsic-size:auto 46px;}
.mp-row.cur{border-color:var(--mode,var(--accent));}
.mp-row .t{flex:1;min-width:0;cursor:pointer;}
.mp-row .t b{display:block;font-weight:400;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mp-row .t span{display:block;font-size:11px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mp-row .d{color:var(--text2);font-size:11px;flex-shrink:0;}
.mp-row .mp-b{width:30px;height:30px;}
.mp-h{font-family:var(--mono);font-size:11px;letter-spacing:0.12em;color:var(--text2);margin-top:6px;}
.mp-big{display:flex;gap:16px;align-items:center;flex-wrap:wrap;}
.mp-big .mp-art{width:140px;height:140px;border-radius:10px;}
.mp-seek{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11px;color:var(--text2);}
.mp-seek input[type=range]{flex:1;accent-color:var(--mode,var(--accent));}
.mp-note{font-family:var(--mono);font-size:11px;color:var(--text2);line-height:1.5;}
.mp-note code{background:var(--bg2);padding:1px 5px;border-radius:4px;}
.mp-in{background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text);font-family:var(--mono);font-size:12px;padding:8px 10px;outline:none;min-width:0;}
.mp-in:focus{border-color:var(--accent);}
@media(max-width:768px){#mp-bar{padding:6px 8px;gap:6px;}#mp-bar .mp-b{width:30px;height:30px;}.mp-big .mp-art{width:96px;height:96px;}.mp-in{font-size:16px;}}

:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
input:focus-visible,textarea:focus-visible,select:focus-visible,button:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--accent)!important;outline-offset:1px}
.auto-toggle{min-height:24px}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
@media(max-width:768px){
#topbar{height:56px}
.tb-btn{height:44px}
#mobile-menu-btn,.tb-btn,#personalitySel,#modelSel,.ibt,#micBtn,#ttsBtn,#sendBtn,#textarea,.sb-btn{min-height:44px}
#mobile-menu-btn,.ibt,#micBtn,#ttsBtn,#sendBtn{min-width:44px}
#mp-bar .mp-b{width:44px;height:44px}
.mode-grid .mode-btn{height:44px}
.stab{width:44px}
.auto-toggle{position:relative}
.auto-toggle::after{content:'';position:absolute;inset:-10px}
}

/* ── Orb tab ── */
#viewtabs{flex-shrink:0;display:flex;gap:4px;padding:8px 18px 0;background:var(--bg1);border-bottom:1px solid var(--border);}
.vtab{font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text2);background:none;border:1px solid transparent;border-bottom:none;border-radius:8px 8px 0 0;padding:7px 16px;min-height:32px;cursor:pointer;}
.vtab:hover{color:var(--text);}
.vtab.active{color:var(--accent);background:var(--bg);border-color:var(--border2);margin-bottom:-1px;}
#orbview{display:none;flex:1;min-height:0;align-items:center;justify-content:center;position:relative;overflow:hidden;background:var(--bg);}
#chat.orb-open #orbview{display:flex;}
#chat.orb-open #msgs,#chat.orb-open #mp-panel{display:none;}
#orb{--o:var(--mode,var(--accent));width:min(46vmin,280px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 30%,color-mix(in srgb,var(--o) 50%,#fff) 0%,var(--o) 38%,color-mix(in srgb,var(--o) 35%,#000) 100%);box-shadow:0 0 40px -6px var(--o),0 0 90px -24px var(--o);opacity:0.5;transition:opacity 0.4s,box-shadow 0.4s;animation:orbIdle 5s ease-in-out infinite;}
#orb.talk{opacity:1;box-shadow:0 0 70px 2px var(--o),0 0 160px 8px var(--o);animation:orbTalk 0.9s ease-in-out infinite;}
#orb-lb{position:absolute;bottom:18px;left:0;right:0;text-align:center;font-family:var(--mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text3);}
@keyframes orbIdle{0%,100%{transform:scale(0.97)}50%{transform:scale(1.03)}}
@keyframes orbTalk{0%,100%{transform:scale(1)}30%{transform:scale(1.09)}60%{transform:scale(1.03)}}
</style>
</head>
<body>
<div id="shell">
<div id="topbar">
  <button id="mobile-menu-btn" onclick="toggleChats()" aria-label="Saved chats" title="Saved chats">☰</button><button id="mobile-cmd-btn" onclick="toggleSidebar()" aria-label="Commands" title="Commands">⌘</button>
  <div class="logo"><div class="pulse" id="pulse"></div>SENTINEL V2</div>
  <div class="mode-badge" id="modeBadge" onclick="toggleAutoMode()" title="Current mode. Click to toggle auto-switching"><span id="mbIc">◈</span><span id="mbLabel">Assistant</span><span class="mb-auto" id="mbAuto">AUTO</span></div>
  <div class="mode-badge" id="gemBadge" onclick="toggleGemini()" title="Send chat to Gemini. Click to toggle. Or start one message with gemini: to use it just for that message"><span>✦</span><span id="gemLabel">GEMINI OFF</span></div>
  <select id="personalitySel" class="tb-in" aria-label="Assistant personality" title="Choose Sentinel personality" onchange="setPersonality(this.value)"><option value="sentinel">Sentinel</option><option value="sayori">Sayori</option><option value="monika">Monika</option><option value="natsuki">Natsuki</option><option value="subaru">Subaru Natsuki</option><option value="beatrice">Beatrice</option><option value="reinhard">Reinhard</option><option value="regulus">Regulus Corneas</option><option value="emilia">Emilia</option><option value="rem">Rem</option><option value="ram">Ram</option><option value="echidna">Echidna</option><option value="shaula">Shaula</option><option value="roxy">Roxy</option><option value="rudeus">Rudeus</option><option value="sylphiette">Sylphiette</option><option value="saiki">Kusuo Saiki</option><option value="thomas">Me</option></select>
  <select id="modelSel" class="tb-in">
    <option value="mistral">mistral</option>
    <option value="llama3.2">llama3.2</option>
    <option value="llama3.1">llama3.1</option>
    <option value="gemma3">gemma3</option>
    <option value="deepseek-r1">deepseek-r1</option>
    <option value="phi3">phi3</option>
    <option value="codellama">codellama</option>
    <option value="moondream">moondream</option>
    <option value="llava">llava</option>
  </select>
  <div class="tb-sep"></div>
  <input id="backendUrl" class="tb-in" type="text" value="http://localhost:8765" />
  <div class="tb-sep"></div>
  <button class="tb-btn" onclick="showThemes()">themes</button>
  <button class="tb-btn" id="ttsToggleBtn" onclick="toggleTTS()">tts off</button>
  <button class="tb-btn" onclick="clearChat()">clear</button>
  <button class="tb-btn" onclick="exportChat()">export</button>
</div>
<div id="sysbar">
  <div class="sc"><div class="sc-l">CPU</div><div class="sc-v" id="s-cpu">—</div><div class="sc-b"><div class="sc-f" id="s-cpu-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">RAM</div><div class="sc-v" id="s-mem">—</div><div class="sc-b"><div class="sc-f" id="s-mem-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">Disk</div><div class="sc-v" id="s-disk">—</div><div class="sc-b"><div class="sc-f" id="s-disk-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">GPU</div><div class="sc-v" id="s-gpu">—</div><div class="sc-b"><div class="sc-f" id="s-gpu-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">VRAM</div><div class="sc-v" id="s-vram">—</div><div class="sc-b"><div class="sc-f" id="s-vram-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">Uptime</div><div class="sc-v" id="s-uptime">—</div></div>
  <div class="sc"><div class="sc-l">Ollama</div><div class="sc-v" id="s-ollama">—</div></div>
