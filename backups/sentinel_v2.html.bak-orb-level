// The backend keeps the mic open and waits for the wake phrase. /api/voice/last_response reports
// wake:{enabled,state} (state: loading, idle, awake, busy) and hands over spoken replies.
// The mic button turns wake listening on and off (the choice is saved by the backend).
var wakeEnabled=false;
var wakeUIState='';

function applyWakeUI(w){
  if(!w) return;
  var on=!!w.enabled, st=on?(w.state||'idle'):'off';
  wakeEnabled=on;
  recording=on;
  if(st===wakeUIState) return;
  wakeUIState=st;
  micBtn.classList.toggle('rec',st==='awake'||st==='busy');
  micBtn.classList.toggle('wake',st==='idle'||st==='loading');
  micBtn.title=on?'Wake listening on: say "Hey Sentinel" (click to turn off)':'Wake listening off (click to turn on)';
  textarea.placeholder=(st==='awake')?'Listening... say your command':'Ask Sentinel anything...';
  if(st==='loading') stL.textContent='loading voice model...';
  else if(st==='idle') stL.textContent='listening for "Hey Sentinel"';
