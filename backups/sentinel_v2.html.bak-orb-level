function artHtml(k,t,p){
  if(k==='d'&&p&&p.art) return '<img src="'+esc(p.art)+'" referrerpolicy="no-referrer" onerror="this.style.display=\'none\'">';
  if(k==='s'&&t&&S.tags&&S.token) return '<img src="'+backend()+'/media/art/'+t.id+'?t='+encodeURIComponent(S.token)+'" onerror="this.style.display=\'none\'">';
  return '';
}
function barState(){
  var b=barSrc();
  if(b.k==='d'){
    var p=b.p;
    return {k:'d',p:p,title:p.title||cap(p.name),sub:(p.artist?p.artist+' · ':'')+cap(p.name),playing:p.status==='Playing',len:p.length,art:artHtml('d',null,p)};
  }
  var t=cur();
  return {k:'s',t:t,title:t?t.title:'Nothing playing',sub:t?(S.err||subOf(t)):(S.err||'Open the player to browse your music'),
          playing:!A.paused&&!!t,len:A.duration>0?A.duration:(t&&t.dur)||0,art:artHtml('s',t)};
}
function renderBar(force){
  var st=barState();
  var sig=[st.k,st.title,st.sub,st.playing,st.art,S.open].join('|');
  if(!force&&sig===S.barSig){tick();return;}
  S.barSig=sig;
  $('mp-bar-art').innerHTML=IC.music+st.art;
  $('mp-title').textContent=st.title; $('mp-sub').textContent=st.sub;
  $('mp-bar-ctl').innerHTML='<button class="mp-b" data-a="prev" title="Previous">'+IC.prev+'</button>'+
    '<button class="mp-b main" data-a="toggle" title="Play / pause">'+(st.playing?IC.pause:IC.play)+'</button>'+
    '<button class="mp-b" data-a="next" title="Next">'+IC.next+'</button>'+
    '<button class="mp-b" data-a="open" title="'+(S.open?'Close':'Open')+' player">'+(S.open?IC.down:IC.up)+'</button>';
  tick();
}
function tick(){
  var st=barState(), pos=st.k==='d'?deskPos(st.p):A.currentTime;
  $('mp-prog-i').style.width=((st.len>0?Math.min(1,pos/st.len):0)*100)+'%';
  var sk=$('mp-seek'), a=$('mp-tcur'), b=$('mp-tdur'), t=cur();
  var sl=A.duration>0?A.duration:(t&&t.dur)||0;
  if(sk&&!S.drag) sk.value=sl>0?Math.round(A.currentTime/sl*1000):0;
  if(a&&!S.drag) a.textContent=fmt(A.currentTime);
  if(b) b.textContent=fmt(sl);
}
function renderTabs(){
  var tabs=[['now','NOW PLAYING'],['lib','LIBRARY'],['queue','QUEUE ('+S.queue.length+')'],['pl','PLAYLISTS']];
  $('mp-tabs').innerHTML=tabs.map(function(t){
    return '<button class="mp-tab'+(S.tab===t[0]?' on':'')+'" data-a="tab" data-v="'+t[0]+'">'+t[1]+'</button>';
  }).join('')+'<span id="mp-flash" class="mp-note" style="margin-left:auto;align-self:center;white-space:nowrap">'+esc(S.msg)+'</span>';
}
function renderPanel(){
  renderTabs();
  var b=$('mp-body');
  if(S.tab==='now') b.innerHTML=nowHtml();
  else if(S.tab==='lib'){ b.innerHTML=libHtml(); renderLibList(); }
  else if(S.tab==='queue') b.innerHTML=queueHtml();
  else b.innerHTML=plHtml();
  tick(); if(S.tab==='now') renderDesk();
}
function refreshUI(){
  renderBar(true);
  if(!S.open) return;
  renderTabs();
  if(S.tab==='lib') renderLibList(); else if(S.tab!=='pl') renderPanel();
}
function nowHtml(){
  var t=cur(), playing=!A.paused&&!!t;
  return '<div class="mp-h">SENTINEL PLAYER</div><div class="mp-big"><div class="mp-art">'+IC.music+(t?artHtml('s',t):'')+'</div>'+
   '<div style="flex:1;min-width:220px;display:flex;flex-direction:column;gap:10px">'+
   '<div class="mp-note" style="color:var(--text);font-size:14px">'+esc(t?t.title:'Nothing queued')+'</div>'+
   '<div class="mp-note">'+esc(t?(S.err||subOf(t)):'Pick something from the Library tab.')+'</div>'+
   '<div class="mp-seek"><span id="mp-tcur">0:00</span><input type="range" id="mp-seek" min="0" max="1000" value="0" data-in="seek"><span id="mp-tdur">0:00</span></div>'+
   '<div class="mp-ctl"><button class="mp-b'+(S.shuffle?' on':'')+'" data-a="shuffle" title="Shuffle '+(S.shuffle?'on':'off')+'">'+IC.shuffle+'</button>'+
   '<button class="mp-b" data-a="sprev" title="Previous">'+IC.prev+'</button>'+
   '<button class="mp-b main" data-a="stog" title="Play / pause">'+(playing?IC.pause:IC.play)+'</button>'+
   '<button class="mp-b" data-a="snext" title="Next">'+IC.next+'</button>'+
   '<button class="mp-b'+(S.repeat!=='off'?' on':'')+'" data-a="repeat" title="Repeat: '+S.repeat+'">'+(S.repeat==='one'?IC.repeat1:IC.repeat)+'</button></div>'+
   '<div class="mp-seek"><span style="display:flex;width:20px;height:20px">'+IC.vol.replace('<svg','<svg style="width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round"')+'</span><input type="range" id="mp-vol" min="0" max="100" value="'+Math.round(S.vol*100)+'" data-in="vol" style="max-width:200px"></div>'+
   '</div></div><div class="mp-h">PLAYING ON THIS DESKTOP</div><div id="mp-desk"></div>';
}
function renderDesk(){
  var el=$('mp-desk'); if(!el) return;
  var list=deskPick(), html;
  if(!list.length) html='<div class="mp-note">Nothing else is playing on this desktop right now.</div>';
  else html=list.map(function(p){
    var i=S.desk.indexOf(p);
    return '<div class="mp-row"><div class="mp-art">'+IC.music+artHtml('d',null,p)+'</div><div class="t"><b>'+esc(p.title||'(no title)')+'</b><span>'+esc((p.artist?p.artist+' · ':'')+cap(p.name)+' · '+p.status.toLowerCase())+'</span></div>'+
      '<button class="mp-b" data-a="dprev" data-p="'+i+'">'+IC.prev+'</button>'+
      '<button class="mp-b main" data-a="dtog" data-p="'+i+'">'+(p.status==='Playing'?IC.pause:IC.play)+'</button>'+
      '<button class="mp-b" data-a="dnext" data-p="'+i+'">'+IC.next+'</button></div>';
  }).join('');
  if(el.dataset.sig!==html){el.dataset.sig=html;el.innerHTML=html;}
}
function libHtml(){
  if(S.err) return '<div class="mp-note">Could not load the library: '+esc(S.err)+'</div>';
  if(!S.loaded) return '<div class="mp-note">Loading library…</div>';
  if(!S.dirOk) return '<div class="mp-note">Music folder not found: '+esc(S.dir)+'<br>Set SENTINEL_MUSIC_DIR in the environment that starts the backend.</div>';
  return '<div class="game-top" style="flex-wrap:wrap"><input class="mp-in" id="mp-q" style="flex:1;min-width:140px" placeholder="Search '+S.lib.length+' tracks…" value="'+esc(S.q)+'" data-in="q">'+
    '<button class="game-btn" data-a="lplay" style="height:34px">PLAY ALL</button><button class="game-btn" data-a="lshuf" style="height:34px">SHUFFLE</button>'+
    '<button class="game-btn" data-a="ladd" style="height:34px">ADD ALL</button><button class="game-btn" data-a="lscan" style="height:34px">RESCAN</button></div>'+
    '<div id="mp-lib-list" style="display:flex;flex-direction:column;gap:6px"></div>'+
    (S.tags?'':'<div class="mp-note">Tip: run <code>pip install mutagen</code> in the project .venv and restart the backend for real titles, artists and cover art. Names come from the files for now.</div>');
}
function renderLibList(){
  var el=$('mp-lib-list'); if(!el) return;
  var q=S.q.trim().toLowerCase(), out=[], last=null, c=cur(); S.shown=[];
  S.lib.forEach(function(t){
    if(q&&(t.title+' '+t.artist+' '+t.album+' '+t.folder).toLowerCase().indexOf(q)<0) return;
    if(t.folder!==last){ last=t.folder; out.push('<div class="mp-h">'+esc(t.folder||'MUSIC (TOP LEVEL)')+'</div>'); }
    var i=S.shown.length, sub=subOf(t,true); S.shown.push(t.id);
    out.push('<div class="mp-row'+(c&&c.id===t.id?' cur':'')+'"><button class="mp-b" data-a="from" data-v="'+i+'" title="Play from here">'+IC.play+'</button>'+
      '<div class="t" data-a="from" data-v="'+i+'"><b>'+esc(t.title)+'</b>'+(sub?'<span>'+esc(sub)+'</span>':'')+'</div>'+
      '<span class="d">'+(t.dur?fmt(t.dur):'')+'</span><button class="mp-b" data-a="add" data-v="'+t.id+'" title="Add to queue">'+IC.plus+'</button></div>');
  });
  el.innerHTML=out.length?out.join(''):'<div class="mp-note">No matches.</div>';
}
function queueHtml(){
  if(!S.queue.length) return '<div class="mp-note">The queue is empty. Add songs from the Library tab, or load a playlist.</div>';
  var rows=S.queue.map(function(id,i){
    var t=S.byId[id]; if(!t) return '';
    return '<div class="mp-row'+(i===S.idx?' cur':'')+'"><span class="d" style="width:26px">'+(i+1)+'</span>'+
      '<div class="t" data-a="qplay" data-v="'+i+'"><b>'+esc(t.title)+'</b><span>'+esc(subOf(t))+'</span></div>'+
      '<span class="d">'+(t.dur?fmt(t.dur):'')+'</span><button class="mp-b" data-a="qrm" data-v="'+i+'" title="Remove">'+IC.x+'</button></div>';
  }).join('');
  return '<div class="game-top"><button class="game-btn" data-a="qclear" style="height:34px">CLEAR QUEUE</button></div>'+rows;
}
function plHtml(){
  var msg=S.plMsg.length?'<div class="mp-note">'+S.plMsg.map(esc).join('<br>')+'</div>':'';
  var rows=S.pls.map(function(p,i){
    return '<div class="mp-row"><div class="t"><b>'+esc(p.name)+'</b><span>'+p.ids.length+' tracks'+(p.missing?' · '+p.missing+' not found':'')+(p.source==='wpl'?' · imported':'')+'</span></div>'+
      '<button class="game-btn" data-a="ppl" data-v="'+i+'" style="height:30px">PLAY</button><button class="game-btn" data-a="padd" data-v="'+i+'" style="height:30px">QUEUE</button>'+
      '<button class="mp-b" data-a="pdel" data-v="'+i+'" title="Delete">'+(S.arm===p.name?'<span style="font-size:11px;color:#f87171">SURE?</span>':IC.x)+'</button></div>';
  }).join('');
  return '<div class="game-top" style="flex-wrap:wrap"><input class="mp-in" id="mp-plname" style="flex:1;min-width:140px" placeholder="Save the current queue as…" value="'+esc(S.saveName)+'" data-in="plname">'+
    '<button class="game-btn" data-a="psave" style="height:34px">SAVE QUEUE</button><button class="game-btn" data-a="pimport" style="height:34px">IMPORT .WPL</button></div>'+
    msg+(rows||'<div class="mp-note">No saved playlists yet.</div>');
}

/* ── playlists ── */
function loadPls(){
  return api('/media/playlists').then(function(j){S.pls=j.playlists||[];S.plLoaded=true;})
    .catch(function(e){S.plMsg=['Could not load playlists: '+e.message];})
    .then(function(){if(S.open&&S.tab==='pl') renderPanel();});
}
function savePl(){
  var name=(($('mp-plname')||{}).value||'').trim();
  if(!name){flash('Give the playlist a name');return;}
  if(!S.queue.length){flash('The queue is empty');return;}
  post('/media/playlists',{name:name,ids:S.queue}).then(function(j){
    S.pls=j.playlists; S.saveName=''; S.plMsg=['Saved "'+name+'" ('+S.queue.length+' tracks)']; renderPanel();
  }).catch(function(e){flash(e.message);});
}
function delPl(i){
  var p=S.pls[i]; if(!p) return;
  if(S.arm!==p.name){
    S.arm=p.name; renderPanel();
    setTimeout(function(){if(S.arm===p.name){S.arm='';if(S.open&&S.tab==='pl')renderPanel();}},3000);
    return;
  }
  S.arm='';
  api('/media/playlists?name='+encodeURIComponent(p.name),{method:'DELETE'}).then(function(j){S.pls=j.playlists;renderPanel();}).catch(function(e){flash(e.message);});
}
function importPl(){
  flash('Importing…');
  api('/media/playlists/import',{method:'POST'}).then(function(j){
    S.pls=j.playlists;
    S.plMsg=j.results.length?j.results.map(function(r){return r.name+': '+r.status+' ('+r.matched+' tracks'+(r.missing?', '+r.missing+' not found':'')+')';}):['No .wpl files found in your music folder.'];
    renderPanel();
  }).catch(function(e){flash(e.message);});
}

/* ── open / close ── */
function setOpen(o,tab){
  var m=$('msgs'), n=m?m.children.length:0;
  if(o&&!S.open) S.msgN=n;
  if(!o&&S.open&&m&&S.msgN!==n) m.scrollTop=m.scrollHeight;
  S.open=o; if(tab) S.tab=tab;
  chat.classList.toggle('mp-open',o);
  if(o){
    if(!S.loaded&&!S.busy) loadLib();
    if(S.tab==='pl'&&!S.plLoaded) loadPls();
    renderPanel();
  }
  renderBar(true);
}

/* ── events (one delegated listener set; no inline handlers) ── */
function act(a,v,el){
  var c;
  switch(a){
    case 'open': setOpen(!S.open); break;
    case 'toggle': tToggle(); break;
    case 'prev': tPrev(); break;
    case 'next': tNext(); break;
    case 'stog': sToggle(); break;
    case 'sprev': sPrev(); break;
    case 'snext': sNext(false); break;
    case 'shuffle': S.shuffle=!S.shuffle; S.played={}; c=cur(); if(c) S.played[c.id]=1; persist(); renderPanel(); break;
    case 'repeat': S.repeat={off:'all',all:'one',one:'off'}[S.repeat]; persist(); renderPanel(); break;
    case 'tab': S.tab=v; if(v==='pl'&&!S.plLoaded) loadPls(); renderPanel(); break;
    case 'from': setQueue(S.shown.slice(),+v); break;
    case 'add': enqueue([v]); break;
    case 'lplay': setQueue(S.shown.slice(),0); break;
    case 'lshuf': S.shuffle=true; setQueue(S.shown.slice(),Math.floor(Math.random()*S.shown.length)); break;
    case 'ladd': enqueue(S.shown.slice()); break;
    case 'lscan': loadLib(true); break;
    case 'qplay': playIndex(+v); break;
    case 'qrm': removeAt(+v); break;
    case 'qclear': clearQueue(); break;
    case 'ppl': setQueue(S.pls[+v].ids.slice(),0); break;
    case 'padd': enqueue(S.pls[+v].ids.slice()); break;
    case 'pdel': delPl(+v); break;
    case 'psave': savePl(); break;
    case 'pimport': importPl(); break;
    case 'dprev': case 'dtog': case 'dnext':
      c=S.desk[+el.dataset.p];
      if(c) deskCtl(c.player,{dprev:'previous',dtog:'play-pause',dnext:'next'}[a]);
      break;
  }
}
function barSeek(e){
  var st=barState(), r=$('mp-prog').getBoundingClientRect(), f=Math.min(1,Math.max(0,(e.clientX-r.left)/r.width));
  if(st.k==='d'){ if(st.len>0) deskCtl(st.p.player,'seek',f*st.len); }
  else if(A.duration>0){ A.currentTime=f*A.duration; }
}
chat.addEventListener('click',function(e){
  if(e.target.closest('#mp-prog')){ barSeek(e); return; }
  var el=e.target.closest('[data-a]');
  if(!el||!(el.closest('#mp-bar')||el.closest('#mp-panel'))) return;
  act(el.dataset.a,el.dataset.v,el);
});
chat.addEventListener('input',function(e){
  var t=e.target, k=t.dataset&&t.dataset.in; if(!k) return;
  if(k==='seek'){ S.drag=true; if(A.duration>0) $('mp-tcur').textContent=fmt(t.value/1000*A.duration); }
  else if(k==='vol'){ S.vol=t.value/100; A.volume=S.vol; persist(); }
  else if(k==='q'){ S.q=t.value; clearTimeout(S.qt); S.qt=setTimeout(renderLibList,120); }
  else if(k==='plname'){ S.saveName=t.value; }
});
chat.addEventListener('change',function(e){
  var t=e.target;
  if(t.dataset&&t.dataset.in==='seek'){ if(A.duration>0) A.currentTime=t.value/1000*A.duration; S.drag=false; }
});
document.addEventListener('pointerup',function(){setTimeout(function(){S.drag=false;},60);});
$('inputbar').addEventListener('focusin',function(e){
  if(S.open&&/^(TEXTAREA|INPUT)$/.test(e.target.tagName)) setOpen(false);
});
A.addEventListener('timeupdate',function(){S.lastT=A.currentTime;tick();});
A.addEventListener('durationchange',tick);
A.addEventListener('loadedmetadata',function(){ if(S.resume>0){A.currentTime=S.resume;S.resume=0;} tick(); });
A.addEventListener('play',function(){renderBar(true);if(S.open&&S.tab==='now')renderPanel();});
A.addEventListener('pause',function(){renderBar(true);if(S.open&&S.tab==='now')renderPanel();});
A.addEventListener('playing',function(){S.fails=0;S.recTry=0;S.err='';setSession();});
A.addEventListener('ended',function(){sNext(true);});
A.addEventListener('error',recover);

/* ── lock-screen / media-key integration ── */
function setSession(){
  var t=cur(); if(!t||!('mediaSession' in navigator)) return;
  try{navigator.mediaSession.metadata=new MediaMetadata({title:t.title,artist:t.artist||'Sentinel',album:t.album||''});}catch(e){}
}
function initSession(){
  if(!('mediaSession' in navigator)) return;
  var h={play:function(){A.play().catch(function(){});},pause:function(){A.pause();},previoustrack:sPrev,nexttrack:function(){sNext(false);},
         seekto:function(d){if(d&&d.seekTime!=null)A.currentTime=d.seekTime;}};
  Object.keys(h).forEach(function(k){try{navigator.mediaSession.setActionHandler(k,h[k]);}catch(e){}});
}

/* ── start ── */
restore(); initSession(); renderBar(true);
setInterval(pollDesk,3000);
document.addEventListener('visibilitychange',function(){if(!document.hidden)pollDesk();});
setTimeout(function(){ if(hasKey()){ loadLib(); pollDesk(); } },1200);
})();

</script>
</body>
</html>
