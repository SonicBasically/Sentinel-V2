async function processActions(actions){
  if(!actions.length) return null;
  var results=[];
  for(var i=0;i<actions.length;i++){
    var action=actions[i];
    var confirmed=true;
    if(needsConfirm(action)) confirmed=await showConfirm(action);
    if(confirmed){
      stL.textContent='running: '+(action.description||action.type)+'...';
      var result=await runAction(action);
      results.push({action:action,result:result});
    }else{
      addResult(action.description||action.type,'Cancelled.',false);
      results.push({action:action,result:{ok:false,output:'Cancelled.'}});
    }
  }
  return results;
}

async function extractActions(userMsg){
  var trimmed=userMsg.trim();
  var greetings=/^(hi|hello|hey|sup|yo|good morning|good evening|good afternoon|how are you|what's up|howdy|thanks|thank you|ok|okay|sure|cool|nice|great)/i;
  if(greetings.test(trimmed)||trimmed.split(' ').length<3) return [];
  if(/\b(use (?:my|the) computer|on my screen|in (?:the )?(?:browser|app|window)|click (?:the|on)|type (?:into|in)|fill (?:in|out)|navigate to|find and click|open and select|(?:open|launch|switch to|go to) .{2,}\b(?:and|then)\b)\b/i.test(trimmed)){
    return [{type:'desktop_agent',task:trimmed,description:'Working through the desktop task'}];
  }
  var keywords=/\b(open |close |kill |reboot|shut down|shutdown|suspend|sleep|navigate to |run |execute |install |update my|upgrade my|start |stop |disable |enable |set volume|set brightness|turn off|turn on|mute|unmute|take a screenshot|write a script|write a file|create a file|create a script|delete |remove |bluetooth)/i;
  if(!keywords.test(trimmed)) return [];
  stL.textContent='processing action...';
  try{
    var prompt='You are a Linux action extractor. Output ONLY one JSON object, no explanation.\n\nUser: "'+userMsg+'"\n\nChoose:\n{"type":"run_command","command":"bash cmd","description":"..."}\n{"type":"open_url","url":"https://...","description":"..."}\n{"type":"reboot","description":"..."}\n{"type":"shutdown","description":"..."}\n{"type":"suspend","description":"..."}\n{"type":"set_volume","level":50,"description":"..."}\n{"type":"mute","description":"..."}\n{"type":"set_brightness","level":80,"description":"..."}\n{"type":"screenshot","description":"..."}\n{"type":"bluetooth_off","description":"..."}\n{"type":"bluetooth_on","description":"..."}\n{"type":"kill_app","app":"name","description":"..."}\n{"type":"write_file","path":"/home/thomasgomez/Desktop/file.py","content":"...","description":"..."}\n{"type":"none"}\n\nExamples:\n"turn off bluetooth" -> {"type":"bluetooth_off","description":"Disabling Bluetooth"}\n"open youtube" -> {"type":"open_url","url":"https://youtube.com","description":"Opening YouTube"}\n"set volume to 40" -> {"type":"set_volume","level":40,"description":"Setting volume to 40%"}\n"what time is it" -> {"type":"none"}\n\nJSON only:';
    var res=await bfetch(ollama()+'/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:document.getElementById('modelSel').value,messages:[{role:'user',content:prompt}],stream:false})});
    var data=await res.json();
    var raw=(data.message&&data.message.content?data.message.content:'').trim();
    raw=raw.replace(/^```(?:json)?\s*/i,'').replace(/\s*```$/,'').trim();
    var match=raw.match(/\{[\s\S]*\}/);
    if(!match) return [];
    var obj=JSON.parse(match[0]);
    if(obj.type&&obj.type!=='none') return [obj];
  }catch(e){console.log('extractActions failed:',e);}
  return [];
}

function isExplicitDesktopRequest(text){
  return /\b(?:use (?:the )?desktop control|use (?:my|the) computer|on (?:my|the) screen|in (?:the )?(?:browser|app|window)|click (?:the|on)|type (?:into|in)|fill (?:in|out)|find and click|open and select)\b/i.test(String(text||''));
}

