var MODEL_ROUTES={vision:'moondream',code:'codellama',default:'mistral'};

// Auto-detect host — if accessed from another device, use that device's IP
   var API_KEY = localStorage.getItem('sentinel_api_key') || '';
   if(!API_KEY){
     API_KEY = (prompt('Enter Sentinel API key:')||'').trim();
     if(API_KEY) localStorage.setItem('sentinel_api_key', API_KEY);
   }

var _host = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1'
  ? window.location.hostname
  : 'localhost';

function ollama(){
  var v = document.getElementById('ollamaUrl').value.trim().replace(/\/$/,'');
  return v.replace('localhost', _host).replace('127.0.0.1', _host);
}
function backend(){
  var v = document.getElementById('backendUrl').value.trim().replace(/\/$/,'');
  return v.replace('localhost', _host).replace('127.0.0.1', _host);
}

// Authenticated fetch — always includes API key
function bfetch(url, opts) {
  opts = opts || {};
  opts.headers = opts.headers || {};
  opts.headers['X-Api-Key'] = API_KEY;
  return fetch(url, opts);
}
function ts(){return new Date().toLocaleTimeString('en-US',{hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit'});}

function pickModel(text,hasImage){
  if(hasImage) return MODEL_ROUTES.vision;
  var t=(text||'').toLowerCase();
  var isCode=/\b(code|script|function|debug|python|javascript|bash|write a|fix this|class|def |const |import )\b/.test(t);
  if(isCode&&availableModels.includes('codellama')) return 'codellama';
  return MODEL_ROUTES.default;
}

function setActiveModel(name){
  var sel=document.getElementById('modelSel');
  var found=false;
  for(var i=0;i<sel.options.length;i++){if(sel.options[i].value===name){found=true;break;}}
  if(!found){var o=document.createElement('option');o.value=name;o.textContent=name;sel.appendChild(o);}
  sel.value=name;
  stR.textContent=name;
}

var THEMES={
  'Default':{'--bg':'#080808','--bg1':'#0f0f0f','--bg2':'#161616','--bg3':'#1e1e1e','--accent':'#c084fc','--accent2':'#a855f7','--border':'#1e1e1e','--border2':'#2a2a2a'},
  'Midnight':{'--bg':'#060a12','--bg1':'#0a1020','--bg2':'#111828','--bg3':'#1a2438','--accent':'#60a5fa','--accent2':'#3b82f6','--border':'#1a2030','--border2':'#243040'},
  'Terminal':{'--bg':'#020804','--bg1':'#071008','--bg2':'#0e1a0e','--bg3':'#162416','--accent':'#4ade80','--accent2':'#22c55e','--border':'#122012','--border2':'#1e3020'},
  'Ember':{'--bg':'#0a0604','--bg1':'#140a06','--bg2':'#1e1008','--bg3':'#2a1a0e','--accent':'#fb923c','--accent2':'#f97316','--border':'#201408','--border2':'#301e10'},
  'Frost':{'--bg':'#06080a','--bg1':'#0a0e12','--bg2':'#10161e','--bg3':'#162028','--accent':'#67e8f9','--accent2':'#22d3ee','--border':'#10181e','--border2':'#1a2630'},
  'Mono':{'--bg':'#080808','--bg1':'#101010','--bg2':'#181818','--bg3':'#222222','--accent':'#e2e2e2','--accent2':'#aaaaaa','--border':'#1e1e1e','--border2':'#2e2e2e'}
};
var activeTheme=localStorage.getItem('sentinel_theme')||'Default';

function applyTheme(name){
  var t=THEMES[name]||THEMES['Default'];
  Object.entries(t).forEach(function(e){document.documentElement.style.setProperty(e[0],e[1]);});
  activeTheme=name;
  localStorage.setItem('sentinel_theme',name);
}
applyTheme(activeTheme);

function showThemes(){
  document.getElementById('panel-title').textContent='Themes';
  var html='<div class="theme-grid">';
  Object.entries(THEMES).forEach(function(e){
    var name=e[0],t=e[1];
    html+='<div class="theme-card'+(name===activeTheme?' active':'')+'" onclick="applyTheme(\''+name+'\');showThemes()">';
    html+='<div class="theme-swatch" style="background:linear-gradient(135deg,'+t['--bg1']+','+t['--accent']+')"></div>';
    html+=name+'</div>';
  });
  html+='</div>';
  document.getElementById('panel-body').innerHTML=html;
  document.getElementById('panel-overlay').classList.add('show');
}
var _devTimer=null;
function closePanel(){
  document.getElementById('panel-overlay').classList.remove('show');
  if(_devTimer){clearInterval(_devTimer);_devTimer=null;}
}

function _escHtml(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}

async function renderDevices(){
  var body=document.getElementById('panel-body');
  try{
    var r=await bfetch(backend()+'/devices/tailnet');
    var d=await r.json();
    if(!d.ok){body.innerHTML='<div class="dev-empty">Could not read Tailscale: '+_escHtml(d.error||'unknown error')+'</div>';return;}
    var online=d.devices.filter(function(x){return x.online;}).length;
    document.getElementById('panel-title').textContent='Devices — '+online+' of '+d.devices.length+' online';
    body.innerHTML=d.devices.map(function(x){
      return '<div class="dev-row '+(x.online?'on':'off')+'">'
        +'<span class="dev-dot"></span>'
        +'<span class="dev-name">'+_escHtml(x.name)+(x.you?' <em>(this device)</em>':(x.self?' <em>(Sentinel host)</em>':''))+'</span>'
        +'<span class="dev-meta">'+_escHtml(x.ip)+' · '+_escHtml(x.os)+'</span></div>';
    }).join('');
  }catch(e){
    body.innerHTML='<div class="dev-empty">Could not reach backend: '+_escHtml(e.message)+'</div>';
  }
}
function showDevices(){
  document.getElementById('panel-title').textContent='Devices';
  document.getElementById('panel-body').innerHTML='<div class="dev-empty">Loading…</div>';
  document.getElementById('panel-overlay').classList.add('show');
  renderDevices();
  if(_devTimer) clearInterval(_devTimer);
  _devTimer=setInterval(renderDevices,10000);
}

function showTab(tab){
  ['cmds','history','dash'].forEach(function(t){
    document.getElementById('panel-'+t).classList.toggle('show',t===tab);
    document.getElementById('tab-'+t).classList.toggle('active',t===tab);
  });
  if(tab==='history') renderHistory();
  if(tab==='dash'){
    // Redraw graphs now that canvas is visible and has dimensions
    setTimeout(function(){
      drawGraph('cpu-graph',graphData.cpu,'#c084fc');
      drawGraph('mem-graph',graphData.mem,'#60a5fa');
      drawGraph('gpu-graph',graphData.gpu,'#4ade80');
    },50);
  }
}

function saveSession(){
  if(!chatHistory.length) return;
  // Use first user message as preview, skip system messages
  var firstUser=chatHistory.find(function(m){return m.role==='user';});
  var preview=firstUser?String(firstUser.content).slice(0,60):'Session';
  sessions.unshift({id:Date.now(),preview:preview,history:chatHistory.slice(),time:new Date().toISOString()});
  sessions=sessions.slice(0,20);
  localStorage.setItem('sentinel_sessions',JSON.stringify(sessions));
  renderHistory();
}

function renderHistory(){
  var el=document.getElementById('hist-list');
  if(!sessions.length){el.innerHTML='<div style="padding:12px;font-family:var(--mono);font-size:10px;color:var(--text3)">No saved sessions</div>';return;}
  var html='';
  sessions.forEach(function(s,i){
    html+='<div class="hist-item" onclick="loadSession('+i+')">';
    html+='<div class="hi-time">'+new Date(s.time).toLocaleDateString()+' '+new Date(s.time).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})+'</div>';
    html+=escHtml(s.preview)+'...</div>';
  });
  el.innerHTML=html;
}

function loadSession(i){
  saveSession();
  chatHistory=sessions[i].history.slice();
  msgsEl.innerHTML='';
  addMsg('ai','Session restored. Continuing from where you left off.');
  showTab('cmds');
}

