<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Sentinel UI V3</title>
<link rel="manifest" href="manifest.json" />
<meta name="theme-color" content="#080808" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Sentinel" />
<meta name="mobile-web-app-capable" content="yes" />
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg:#080808;--bg1:#0f0f0f;--bg2:#161616;--bg3:#1e1e1e;
  --border:#1e1e1e;--border2:#2a2a2a;
  --text:#e2e2e2;--text2:#666;--text3:#383838;
  --accent:#c084fc;--accent2:#a855f7;
  --green:#4ade80;--red:#f87171;--yellow:#fbbf24;--blue:#60a5fa;
  --mono:'JetBrains Mono','Fira Code',monospace;
  --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:var(--sans);}
#shell{display:grid;grid-template-rows:auto auto 1fr;height:100vh;width:100vw;overflow:hidden;}
#topbar{display:flex;align-items:center;gap:10px;padding:0 18px;height:50px;background:var(--bg1);border-bottom:1px solid var(--border);flex-shrink:0;}
.logo{font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:0.2em;color:var(--text);display:flex;align-items:center;gap:9px;white-space:nowrap;margin-right:auto;}
.pulse{width:7px;height:7px;border-radius:50%;background:var(--text3);flex-shrink:0;transition:all 0.4s;}
.pulse.on{background:var(--green);box-shadow:0 0 8px #4ade8055;}
.pulse.err{background:var(--red);}
.tb-in{font-family:var(--mono);font-size:11px;background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text);padding:4px 9px;height:28px;outline:none;}
#ollamaUrl{width:170px;}#modelSel{width:125px;cursor:pointer;}#backendUrl{width:150px;}
.tb-sep{width:1px;height:18px;background:var(--border2);flex-shrink:0;}
.tb-btn{font-family:var(--mono);font-size:11px;background:transparent;border:1px solid var(--border2);border-radius:6px;color:var(--text2);padding:0 11px;height:28px;cursor:pointer;white-space:nowrap;transition:all 0.15s;}
.tb-btn:hover{color:var(--text);border-color:#3a3a3a;}
.tb-btn.active{color:var(--accent);border-color:var(--accent2);}
#sysbar{display:grid;grid-template-columns:repeat(8,1fr);gap:6px;padding:7px 18px;background:var(--bg1);border-bottom:1px solid var(--border);flex-shrink:0;}
.sc{background:var(--bg2);border:1px solid var(--border);border-radius:7px;padding:6px 9px;}
.sc-click{cursor:pointer;transition:border-color 0.15s;}
.sc-click:hover{border-color:var(--accent2);}
.sc-v.dev-ok{color:var(--green);}.sc-v.dev-bad{color:var(--text2);}
.sc-l{font-family:var(--mono);font-size:9px;color:var(--text3);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:3px;}
.sc-v{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sc-b{height:2px;background:var(--border2);border-radius:1px;margin-top:4px;overflow:hidden;}
.sc-f{height:100%;border-radius:1px;background:var(--text2);transition:width 0.5s,background 0.5s;}
.sc-f.warn{background:var(--yellow);}.sc-f.crit{background:var(--red);}
#main{display:grid;grid-template-columns:236px 1fr;overflow:hidden;min-height:0;}
#sidebar{background:var(--bg1);border-right:1px solid var(--border);display:grid;grid-template-columns:44px 1fr;overflow:hidden;min-height:0;}
#sidebar-tabs{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 0;border-right:1px solid var(--border);}
.stab{width:36px;height:44px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:0;color:var(--text2);cursor:pointer;border:none;background:none;border-radius:8px;transition:all 0.15s;}
.stab:hover{color:var(--text);background:var(--bg2);}.stab.active{color:var(--accent);background:var(--bg2);}
.stab-ic{font-size:16px;line-height:1;}
.stab-lb{font-family:var(--mono);font-size:7px;letter-spacing:0.08em;text-transform:uppercase;}
#sb-main{display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;}
#sb-top{display:flex;flex-direction:column;gap:8px;padding:10px;border-bottom:1px solid var(--border);flex-shrink:0;}
#sb-panels{display:flex;flex-direction:column;flex:1;min-height:0;overflow:hidden;}
.sidebar-panel{display:none;flex-direction:column;flex:1;overflow-y:auto;overflow-x:hidden;}
.sidebar-panel.show{display:flex;}
.sidebar-panel::-webkit-scrollbar{width:3px;}
.sidebar-panel::-webkit-scrollbar-thumb{background:var(--border2);}
.sb-sec{padding:12px 12px 5px;font-family:var(--mono);font-size:9px;color:var(--text3);letter-spacing:0.12em;text-transform:uppercase;}
.sb-btn{display:flex;align-items:center;gap:8px;padding:7px 12px;font-family:var(--mono);font-size:11px;color:var(--text2);cursor:pointer;background:none;border:none;width:100%;text-align:left;transition:all 0.1s;}
.sb-btn:hover{background:var(--bg2);color:var(--text);}
.sb-btn .ic{font-size:11px;width:13px;text-align:center;flex-shrink:0;}
.sb-div{margin:5px 12px;border:none;border-top:1px solid var(--border);}
body{--mode:var(--accent);}
.mode-sec{display:flex;align-items:center;justify-content:space-between;}
.auto-toggle{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:8px;letter-spacing:0.12em;padding:2px 8px;border-radius:999px;border:1px solid var(--border2);background:none;color:var(--text2);cursor:pointer;transition:all 0.18s;}
.auto-toggle:hover{color:var(--text);}
.auto-dot{width:5px;height:5px;border-radius:50%;background:var(--text3);transition:all 0.2s;}
.auto-toggle.on{color:var(--mode);border-color:var(--mode);}
.auto-toggle.on .auto-dot{background:var(--mode);box-shadow:0 0 6px var(--mode);}
.mode-btn{--mc:var(--accent);position:relative;display:flex;align-items:center;gap:10px;padding:8px 10px;margin:3px 10px;width:calc(100% - 20px);font-family:var(--mono);color:var(--text2);cursor:pointer;background:var(--bg1);border:1px solid var(--border);border-radius:8px;text-align:left;transition:all 0.18s;overflow:hidden;}
.mode-btn[data-mode=assistant]{--mc:var(--accent);}
.mode-btn[data-mode=sysadmin]{--mc:#fbbf24;}
.mode-btn[data-mode=developer]{--mc:#60a5fa;}
.mode-btn[data-mode=security]{--mc:#f87171;}
.mode-btn::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--mc);opacity:0;transition:opacity 0.18s;}
.mode-btn:hover{background:var(--bg2);color:var(--text);border-color:var(--border2);}
.mode-btn.active{color:var(--text);border-color:var(--mc);background:linear-gradient(90deg,rgba(255,255,255,0.05),transparent 80%);box-shadow:0 0 14px -5px var(--mc);}
.mode-btn.active::before{opacity:1;}
.mc-ic{width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:13px;background:var(--bg3);color:var(--mc);flex-shrink:0;transition:all 0.18s;}
.mode-btn.active .mc-ic{background:var(--mc);color:#0a0a0a;}
.mc-txt{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1;}
.mc-name{font-size:11px;font-weight:600;letter-spacing:0.02em;}
.mc-desc{font-size:9px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mc-flag{font-size:8px;letter-spacing:0.12em;color:var(--mc);flex-shrink:0;}
.mode-btn.pulse{animation:modePulse 0.7s ease-out;}
@keyframes modePulse{0%{box-shadow:0 0 0 0 var(--mc);}100%{box-shadow:0 0 0 12px transparent;}}
.mode-badge{display:flex;align-items:center;gap:7px;height:26px;padding:0 10px;border-radius:999px;border:1px solid var(--mode);background:var(--bg2);font-family:var(--mono);font-size:10px;color:var(--text);cursor:pointer;flex-shrink:0;transition:all 0.25s;box-shadow:0 0 12px -6px var(--mode);}
.mode-badge #mbIc{color:var(--mode);font-size:12px;}
.mode-badge .mb-auto{font-size:8px;letter-spacing:0.12em;color:var(--mode);border-left:1px solid var(--border2);padding-left:7px;}
#topbar{position:relative;}
#topbar::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:1px;background:linear-gradient(90deg,transparent,var(--mode),transparent);opacity:0.55;pointer-events:none;transition:all 0.3s;}
.mode-note{display:flex;align-items:center;gap:7px;width:fit-content;align-self:center;margin:8px auto;padding:4px 12px;font-family:var(--mono);font-size:10px;color:var(--text2);border:1px solid var(--border2);border-radius:999px;background:var(--bg1);animation:modeNoteIn 0.35s ease-out;}
.mode-note .mn-ic{color:var(--mc);}
.mode-note b{color:var(--mc);font-weight:600;}
.mode-note .mn-auto{font-size:8px;letter-spacing:0.12em;color:var(--text3);border-left:1px solid var(--border2);padding-left:7px;}
@keyframes modeNoteIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
.sb-modehead{display:flex;align-items:center;justify-content:space-between;gap:8px;}
.sb-modelabel{font-family:var(--mono);font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--mode);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mode-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;}
.mode-grid .mode-btn{margin:0;width:auto;padding:0;height:36px;justify-content:center;gap:0;border-radius:8px;}
.mode-grid .mc-txt,.mode-grid .mc-flag{display:none;}
.mode-grid .mc-ic{width:100%;height:100%;border-radius:0;background:transparent;font-size:14px;}
.mode-grid .mode-btn.active .mc-ic{background:var(--mc);color:#0a0a0a;}
#sb-search{display:flex;align-items:center;gap:6px;height:30px;padding:0 8px;background:var(--bg2);border:1px solid var(--border2);border-radius:8px;transition:border-color 0.15s;cursor:text;}
#sb-search:focus-within{border-color:var(--accent);}
.sb-sic{color:var(--text3);font-size:13px;}
#cmdSearch{flex:1;min-width:0;background:none;border:none;outline:none;color:var(--text);font-family:var(--mono);font-size:11px;}
#cmdSearch::placeholder{color:var(--text3);}
.sb-kbd{font-family:var(--mono);font-size:9px;color:var(--text3);border:1px solid var(--border2);border-radius:4px;padding:0 5px;line-height:15px;}
#cmdSearch:not(:placeholder-shown)~.sb-kbd{display:none;}
#cmdSearchClear{display:none;background:none;border:none;color:var(--text2);font-size:15px;line-height:1;cursor:pointer;padding:0 2px;}
#cmdSearch:not(:placeholder-shown)~#cmdSearchClear{display:block;}
.sb-grp .sb-sec{padding-top:10px;}
.sb-nores{padding:14px 12px;font-family:var(--mono);font-size:10px;color:var(--text3);}
@media(max-width:768px){.sb-btn{padding:10px 12px;font-size:12px;}.mode-grid .mode-btn{height:42px;}#sb-search{height:38px;}#cmdSearch{font-size:16px;}.sb-kbd{display:none;}}
.g-sys{--gc:#c084fc;}.g-net{--gc:#60a5fa;}.g-tools{--gc:#4ade80;}
.sb-grp .sb-btn .ic{width:18px;height:18px;display:flex;align-items:center;justify-content:center;color:var(--gc);opacity:0.85;transition:opacity 0.1s;}
.sb-grp .sb-btn:hover .ic{opacity:1;}
.ico{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
@media(max-width:768px){.mode-badge{display:none;}}
.hist-item{padding:8px 12px;font-family:var(--mono);font-size:10px;color:var(--text2);cursor:pointer;border-bottom:1px solid var(--border);transition:all 0.1s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.hist-item:hover{background:var(--bg2);color:var(--text);}
.hist-item .hi-time{font-size:9px;color:var(--text3);margin-bottom:2px;}
#dashboard{padding:10px 12px;display:flex;flex-direction:column;gap:8px;}
.dash-card{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;}
.dash-title{font-family:var(--mono);font-size:9px;color:var(--text3);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:8px;}
.dash-graph{height:50px;position:relative;overflow:hidden;}
.dash-graph canvas{width:100%;height:100%;}
#chat{display:flex;flex-direction:column;overflow:hidden;min-height:0;background:var(--bg);position:relative;}
#panel-overlay{display:none;position:absolute;inset:0;background:rgba(8,8,8,0.97);z-index:40;flex-direction:column;padding:20px;gap:12px;overflow-y:auto;}
#panel-overlay.show{display:flex;}
.dev-row{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;font-family:var(--mono);font-size:12px;}
.dev-row .dev-dot{width:9px;height:9px;border-radius:50%;background:var(--text2);flex-shrink:0;}
.dev-row.on .dev-dot{background:var(--green);box-shadow:0 0 8px #4ade8055;}
.dev-row.off{opacity:0.55;}
.dev-name{color:var(--text);font-weight:600;}
.dev-name em{color:var(--accent);font-style:normal;font-weight:400;font-size:10px;}
.dev-meta{margin-left:auto;color:var(--text2);font-size:11px;}
.dev-empty{font-family:var(--mono);font-size:12px;color:var(--text2);}
.game-top{display:flex;gap:8px;}
#game-q{flex:1;background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text);font-family:var(--mono);font-size:12px;padding:8px 10px;outline:none;}
#game-q:focus{border-color:var(--accent);}
.game-btn{background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--text2);font-family:var(--mono);font-size:10px;letter-spacing:0.1em;padding:0 12px;cursor:pointer;}
.game-btn:hover{color:var(--text);border-color:var(--accent);}
#game-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;}
.game-card{cursor:pointer;background:var(--bg2);border:1px solid var(--border);border-radius:8px;overflow:hidden;transition:all 0.15s;font-family:var(--mono);display:flex;flex-direction:column;}
.game-card:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 6px 18px -8px var(--accent);}
.game-card.off{opacity:0.55;}
.game-art{position:relative;aspect-ratio:460/215;overflow:hidden;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,hsl(var(--h),45%,22%),hsl(calc(var(--h) + 40),45%,12%));}
.game-art .ltr{font-size:34px;font-weight:700;color:rgba(255,255,255,0.35);}
.game-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 0.3s;}
.game-art img.in{opacity:1;}
.game-art.k-portrait img{object-position:center 20%;}
.game-art.k-icon img{object-fit:contain;padding:16%;box-sizing:border-box;}
.game-foot{padding:8px 10px;}
.game-name{font-size:12px;color:var(--text);font-weight:600;line-height:1.3;}
.game-tag{font-size:8px;letter-spacing:0.12em;color:var(--text2);margin-top:4px;}
.game-choices{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;}
.game-pick{background:var(--bg2);border:1px solid var(--border2);border-radius:999px;color:var(--text);font-family:var(--mono);font-size:11px;padding:4px 12px;cursor:pointer;}
.game-pick:hover{border-color:var(--accent);color:var(--accent);}
.panel-header{display:flex;align-items:center;justify-content:space-between;}
.panel-title{font-family:var(--mono);font-size:13px;font-weight:600;color:var(--text);}
.panel-close{font-family:var(--mono);font-size:11px;color:var(--text2);cursor:pointer;background:none;border:1px solid var(--border2);border-radius:5px;padding:3px 8px;}
.panel-close:hover{color:var(--text);}
#ss-preview{max-width:100%;border-radius:8px;border:1px solid var(--border2);}
.theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.theme-card{border:1px solid var(--border2);border-radius:8px;padding:12px;cursor:pointer;transition:border-color 0.15s;text-align:center;font-family:var(--mono);font-size:11px;}
.theme-card:hover{border-color:#444;}.theme-card.active{border-color:var(--accent);}
.theme-swatch{height:30px;border-radius:5px;margin-bottom:8px;}
#msgs{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:18px;display:flex;flex-direction:column;gap:14px;}
#msgs::-webkit-scrollbar{width:3px;}
#msgs::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
.msg{display:flex;flex-direction:column;gap:4px;max-width:87%;}
.msg.user{align-self:flex-end;align-items:flex-end;}
.msg.ai{align-self:flex-start;align-items:flex-start;}
.bubble{font-size:13px;line-height:1.7;padding:10px 14px;border-radius:12px;word-break:break-word;white-space:pre-wrap;}
.msg.user .bubble{background:var(--bg3);border:1px solid var(--border2);border-bottom-right-radius:3px;}
.msg.ai .bubble{background:var(--bg1);border:1px solid var(--border);border-bottom-left-radius:3px;}
.bubble code{font-family:var(--mono);font-size:11.5px;background:var(--bg3);border:1px solid var(--border2);border-radius:4px;padding:1px 5px;}
.bubble pre{font-family:var(--mono);font-size:11.5px;background:var(--bg);border:1px solid var(--border2);border-radius:8px;padding:11px 13px;margin:7px 0;overflow-x:auto;white-space:pre;line-height:1.5;}
.bubble pre code{background:none;border:none;padding:0;}
.msg-meta{font-family:var(--mono);font-size:9.5px;color:var(--text3);padding:0 2px;}
.chat-screenshot{max-width:100%;border-radius:8px;border:1px solid var(--border2);margin-top:4px;cursor:pointer;}
.typing{display:flex;gap:5px;align-items:center;padding:10px 14px;background:var(--bg1);border:1px solid var(--border);border-radius:12px;border-bottom-left-radius:3px;width:fit-content;}
.typing span{width:5px;height:5px;border-radius:50%;background:var(--text3);animation:blink 1.3s infinite;}
.typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,80%,100%{opacity:0.2;transform:scale(1)}40%{opacity:1;transform:scale(1.2)}}
.sys-block{font-family:var(--mono);font-size:11px;background:var(--bg1);border:1px solid var(--border);border-radius:10px;padding:11px 13px;color:var(--text2);max-width:540px;overflow-x:auto;}
#drop-ov{display:none;position:absolute;inset:0;background:rgba(8,8,8,0.92);z-index:50;flex-direction:column;align-items:center;justify-content:center;gap:10px;font-family:var(--mono);font-size:13px;color:var(--text2);border:1px dashed var(--border2);margin:14px;border-radius:12px;}
#drop-ov.show{display:flex;}
#confirm-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:999;align-items:center;justify-content:center;}
#confirm-modal.show{display:flex;}
.confirm-box{background:#0f0f0f;border:1px solid #2a2a2a;border-radius:14px;padding:28px 30px;max-width:440px;width:90%;font-family:var(--mono);}
.confirm-icon{font-size:24px;margin-bottom:10px;}
.confirm-title{font-size:14px;color:var(--text);font-weight:600;margin-bottom:6px;}
.confirm-detail{font-size:11px;color:#888;background:#0a0a0a;border:1px solid #1e1e1e;border-radius:7px;padding:9px 11px;margin:10px 0;word-break:break-all;max-height:100px;overflow-y:auto;}
.confirm-btns{display:flex;gap:10px;margin-top:18px;}
.confirm-yes{flex:1;padding:9px;border-radius:7px;border:1px solid var(--green);background:transparent;color:var(--green);font-family:var(--mono);font-size:11px;cursor:pointer;letter-spacing:0.08em;}
.confirm-no{flex:1;padding:9px;border-radius:7px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-family:var(--mono);font-size:11px;cursor:pointer;}
#save-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:999;align-items:center;justify-content:center;}
#save-modal.show{display:flex;}
#inputbar{flex-shrink:0;border-top:1px solid var(--border);background:var(--bg1);padding:10px 18px 12px;display:flex;flex-direction:column;gap:7px;}
#file-chip{display:none;align-items:center;gap:7px;padding:4px 9px;background:var(--bg2);border:1px solid var(--border2);border-radius:5px;font-family:var(--mono);font-size:10px;color:var(--text2);}
#file-chip.show{display:flex;}
#file-chip .fname{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text);}
#file-chip .rm{cursor:pointer;color:var(--text3);}#file-chip .rm:hover{color:var(--text);}
#input-row{display:flex;gap:7px;align-items:flex-end;}
#textarea{flex:1;background:var(--bg2);border:1px solid var(--border2);border-radius:10px;padding:9px 13px;font-size:13px;font-family:var(--sans);color:var(--text);resize:none;min-height:40px;max-height:120px;line-height:1.5;outline:none;transition:border-color 0.15s;}
#textarea:focus{border-color:#2e2e2e;}
#textarea::placeholder{color:var(--text3);}
.ibt{width:40px;height:40px;border-radius:9px;border:1px solid var(--border2);background:var(--bg2);color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;transition:all 0.15s;}
.ibt:hover{color:var(--text);border-color:#3a3a3a;}
.ibt:disabled{opacity:0.3;cursor:not-allowed;}
.ibt.send{background:var(--bg3);border-color:#2e2e2e;color:var(--text);}
.ibt.send:hover{background:#222;}
.ibt.rec{color:var(--red);border-color:var(--red);background:#140a0a;animation:rpulse 1s infinite;}
.ibt.tts-on{color:var(--accent);border-color:var(--accent2);}
@keyframes rpulse{0%,100%{opacity:1}50%{opacity:0.6}}
#statusbar{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;color:var(--text3);}
select option{background:#161616;}
/* ── MOBILE RESPONSIVE ── */
@media (max-width: 768px) {
  #topbar {
    padding: 0 10px;
    height: 46px;
    gap: 6px;
    flex-wrap: nowrap;
    overflow-x: auto;
  }
  .logo { font-size: 10px; letter-spacing: 0.12em; }
  #ollamaUrl, #backendUrl { display: none; }
  #modelSel { width: 100px; font-size: 10px; }
  .tb-sep { display: none; }
  .tb-btn { font-size: 10px; padding: 0 7px; height: 26px; }

  #sysbar {
    grid-template-columns: repeat(3, 1fr);
    padding: 5px 10px;
    gap: 4px;
  }
  #sysbar .sc:nth-child(5),
  #sysbar .sc:nth-child(6) { display: none; }
  .sc-v { font-size: 11px; }
  .sc-l { font-size: 8px; }

  #main { grid-template-columns: 1fr; }

  #sidebar {
    display: none;
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: 280px;
    z-index: 200;
    box-shadow: 4px 0 20px rgba(0,0,0,0.8);
  }
  #sidebar.mobile-open { display: grid; }

  #sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 199;
  }
  #sidebar-overlay.show { display: block; }

  #chat { width: 100%; }

  #msgs { padding: 12px 10px; gap: 10px; }
  .msg { max-width: 95%; }
  .bubble { font-size: 13px; padding: 9px 12px; }

  #inputbar { padding: 8px 10px 10px; gap: 5px; }
  #input-row { gap: 5px; }
  #textarea { font-size: 13px; padding: 8px 10px; }
  .ibt { width: 38px; height: 38px; font-size: 15px; }

  /* Mobile menu button */
  #mobile-menu-btn {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 28px;
    border: 1px solid var(--border2);
    border-radius: 6px;
    background: var(--bg2);
    color: var(--text2);
    cursor: pointer;
    font-size: 14px;
    flex-shrink: 0;
  }
}

@media (min-width: 769px) {
  #mobile-menu-btn { display: none !important; }
  #sidebar-overlay { display: none !important; }
}

/* Safe area for notches */
@supports (padding: max(0px)) {
  #inputbar { padding-bottom: max(12px, env(safe-area-inset-bottom)); }
  #topbar   { padding-top: max(0px, env(safe-area-inset-top)); }
}

</style>
</head>
<body>
<div id="shell">
<div id="topbar">
  <button id="mobile-menu-btn" onclick="toggleSidebar()">☰</button>
  <div class="logo"><div class="pulse" id="pulse"></div>SENTINEL UI V3</div>
  <div class="mode-badge" id="modeBadge" onclick="toggleAutoMode()" title="Current mode. Click to toggle auto-switching"><span id="mbIc">◈</span><span id="mbLabel">Assistant</span><span class="mb-auto" id="mbAuto">AUTO</span></div>
  <input id="ollamaUrl" class="tb-in" type="text" value="http://localhost:11434" />
  <select id="modelSel" class="tb-in">
    <option value="mistral">mistral</option>
    <option value="llama3.2">llama3.2</option>
    <option value="llama3.1">llama3.1</option>
    <option value="gemma3">gemma3</option>
    <option value="deepseek-r1">deepseek-r1</option>
    <option value="phi3">phi3</option>
    <option value="codellama">codellama</option>
    <option value="moondream">moondream</option>
    <option value="llava">llava</option>
  </select>
  <div class="tb-sep"></div>
  <input id="backendUrl" class="tb-in" type="text" value="http://localhost:8765" />
  <div class="tb-sep"></div>
  <button class="tb-btn" onclick="showThemes()">themes</button>
  <button class="tb-btn" id="ttsToggleBtn" onclick="toggleTTS()">tts off</button>
  <button class="tb-btn" onclick="clearChat()">clear</button>
  <button class="tb-btn" onclick="exportChat()">export</button>
</div>
<div id="sysbar">
  <div class="sc"><div class="sc-l">CPU</div><div class="sc-v" id="s-cpu">—</div><div class="sc-b"><div class="sc-f" id="s-cpu-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">RAM</div><div class="sc-v" id="s-mem">—</div><div class="sc-b"><div class="sc-f" id="s-mem-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">Disk</div><div class="sc-v" id="s-disk">—</div><div class="sc-b"><div class="sc-f" id="s-disk-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">GPU</div><div class="sc-v" id="s-gpu">—</div><div class="sc-b"><div class="sc-f" id="s-gpu-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">VRAM</div><div class="sc-v" id="s-vram">—</div><div class="sc-b"><div class="sc-f" id="s-vram-b" style="width:0"></div></div></div>
  <div class="sc"><div class="sc-l">Uptime</div><div class="sc-v" id="s-uptime">—</div></div>
  <div class="sc"><div class="sc-l">Ollama</div><div class="sc-v" id="s-ollama">—</div></div>
  <div class="sc sc-click" onclick="showDevices()" title="Show all tailnet devices"><div class="sc-l">Devices</div><div class="sc-v" id="s-devices">—</div></div>
</div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><symbol id="i-activity" viewBox="0 0 24 24"><path d="M3 12h4l3 8l4 -16l3 8h4"/></symbol><symbol id="i-brain" viewBox="0 0 24 24"><path d="M15.5 13a3.5 3.5 0 0 0 -3.5 3.5v1a3.5 3.5 0 0 0 7 0v-1.8"/> <path d="M8.5 13a3.5 3.5 0 0 1 3.5 3.5v1a3.5 3.5 0 0 1 -7 0v-1.8"/> <path d="M17.5 16a3.5 3.5 0 0 0 0 -7h-.5"/> <path d="M19 9.3v-2.8a3.5 3.5 0 0 0 -7 0"/> <path d="M6.5 16a3.5 3.5 0 0 1 0 -7h.5"/> <path d="M5 9.3v-2.8a3.5 3.5 0 0 1 7 0v10"/></symbol><symbol id="i-camera" viewBox="0 0 24 24"><path d="M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2"/> <path d="M9 13a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/></symbol><symbol id="i-clipboard" viewBox="0 0 24 24"><path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"/> <path d="M9 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2"/></symbol><symbol id="i-cpu" viewBox="0 0 24 24"><path d="M5 6a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-12a1 1 0 0 1 -1 -1l0 -12"/> <path d="M9 9h6v6h-6l0 -6"/> <path d="M3 10h2"/> <path d="M3 14h2"/> <path d="M10 3v2"/> <path d="M14 3v2"/> <path d="M21 10h-2"/> <path d="M21 14h-2"/> <path d="M14 21v-2"/> <path d="M10 21v-2"/></symbol><symbol id="i-database" viewBox="0 0 24 24"><path d="M4 6a8 3 0 1 0 16 0a8 3 0 1 0 -16 0"/> <path d="M4 6v6a8 3 0 0 0 16 0v-6"/> <path d="M4 12v6a8 3 0 0 0 16 0v-6"/></symbol><symbol id="i-device-desktop" viewBox="0 0 24 24"><path d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10"/> <path d="M7 20h10"/> <path d="M9 16v4"/> <path d="M15 16v4"/></symbol><symbol id="i-device-gamepad-2" viewBox="0 0 24 24"><path d="M12 5h3.5a5 5 0 0 1 0 10h-5.5l-4.015 4.227a2.3 2.3 0 0 1 -3.923 -2.035l1.634 -8.173a5 5 0 0 1 4.904 -4.019h3.4"/> <path d="M14 15l4.07 4.284a2.3 2.3 0 0 0 3.925 -2.023l-1.6 -8.232"/> <path d="M8 9v2"/> <path d="M7 10h2"/> <path d="M14 10h2"/></symbol><symbol id="i-devices" viewBox="0 0 24 24"><path d="M13 9a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-6a1 1 0 0 1 -1 -1v-10"/> <path d="M18 8v-3a1 1 0 0 0 -1 -1h-13a1 1 0 0 0 -1 1v12a1 1 0 0 0 1 1h9"/> <path d="M16 9h2"/></symbol><symbol id="i-file-text" viewBox="0 0 24 24"><path d="M14 3v4a1 1 0 0 0 1 1h4"/> <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2"/> <path d="M9 9l1 0"/> <path d="M9 13l6 0"/> <path d="M9 17l6 0"/></symbol><symbol id="i-git-branch" viewBox="0 0 24 24"><path d="M5 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/> <path d="M5 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/> <path d="M15 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/> <path d="M7 8l0 8"/> <path d="M9 18h6a2 2 0 0 0 2 -2v-5"/> <path d="M14 14l3 -3l3 3"/></symbol><symbol id="i-memory" viewBox="0 0 24 24"><path d="M12 11v2"/> <path d="M16 11v2"/> <path d="M3 7h18a1 1 0 0 1 1 1v1a1 1 0 0 1 -1 1a1 1 0 0 0 -1 1v1a1 1 0 0 0 1 1a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-18a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1a1 1 0 0 0 1 -1v-1a1 1 0 0 0 -1 -1a1 1 0 0 1 -1 -1v-1a1 1 0 0 1 1 -1"/> <path d="M8 11v2"/> <path d="M4 17v2"/> <path d="M7 17v2"/> <path d="M10 17v2"/> <path d="M20 17v2"/> <path d="M17 17v2"/> <path d="M13 17v2"/></symbol><symbol id="i-plug-connected" viewBox="0 0 24 24"><path d="M7 12l5 5l-1.5 1.5a3.536 3.536 0 1 1 -5 -5l1.5 -1.5"/> <path d="M17 12l-5 -5l1.5 -1.5a3.536 3.536 0 1 1 5 5l-1.5 1.5"/> <path d="M3 21l2.5 -2.5"/> <path d="M18.5 5.5l2.5 -2.5"/> <path d="M10 11l-2 2"/> <path d="M13 14l-2 2"/></symbol><symbol id="i-settings" viewBox="0 0 24 24"><path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065"/> <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/></symbol><symbol id="i-volume" viewBox="0 0 24 24"><path d="M15 8a5 5 0 0 1 0 8"/> <path d="M17.7 5a9 9 0 0 1 0 14"/> <path d="M6 15h-2a1 1 0 0 1 -1 -1v-4a1 1 0 0 1 1 -1h2l3.5 -4.5a.8 .8 0 0 1 1.5 .5v14a.8 .8 0 0 1 -1.5 .5l-3.5 -4.5"/></symbol><symbol id="i-wifi" viewBox="0 0 24 24"><path d="M12 18l.01 0"/> <path d="M9.172 15.172a4 4 0 0 1 5.656 0"/> <path d="M6.343 12.343a8 8 0 0 1 11.314 0"/> <path d="M3.515 9.515c4.686 -4.687 12.284 -4.687 17 0"/></symbol></defs></svg>
<div id="main">
  <div id="sidebar">
    <div id="sidebar-tabs">
      <button class="stab active" id="tab-cmds" onclick="showTab('cmds')" title="Commands" aria-label="Commands"><span class="stab-ic">⌘</span><span class="stab-lb">cmds</span></button>
      <button class="stab" id="tab-history" onclick="showTab('history')" title="Past sessions" aria-label="Past sessions"><span class="stab-ic">↺</span><span class="stab-lb">hist</span></button>
      <button class="stab" id="tab-dash" onclick="showTab('dash')" title="Dashboard" aria-label="Dashboard"><span class="stab-ic">▥</span><span class="stab-lb">dash</span></button>
    </div>
    <div id="sb-main">
      <div id="sb-top">
        <div class="sb-modehead"><span class="sb-modelabel" id="sbModeLabel">Assistant</span><button class="auto-toggle on" id="autoToggle" onclick="toggleAutoMode()" title="Switch mode automatically based on what you type"><span class="auto-dot"></span>AUTO</button></div>
        <div class="mode-grid">
          <button class="mode-btn active" id="m-assistant" data-mode="assistant" onclick="setMode('assistant',true)" title="Assistant: Everyday help &amp; quick actions" aria-label="Assistant mode"><span class="mc-ic">◈</span><span class="mc-txt"><span class="mc-name">Assistant</span><span class="mc-desc">Everyday help &amp; quick actions</span></span><span class="mc-flag"></span></button>
          <button class="mode-btn" id="m-sysadmin" data-mode="sysadmin" onclick="setMode('sysadmin',true)" title="Sysadmin: Services, logs, disks, packages" aria-label="Sysadmin mode"><span class="mc-ic">▣</span><span class="mc-txt"><span class="mc-name">Sysadmin</span><span class="mc-desc">Services, logs, disks, packages</span></span><span class="mc-flag"></span></button>
          <button class="mode-btn" id="m-developer" data-mode="developer" onclick="setMode('developer',true)" title="Developer: Code, debugging, git, scripts" aria-label="Developer mode"><span class="mc-ic">{}</span><span class="mc-txt"><span class="mc-name">Developer</span><span class="mc-desc">Code, debugging, git, scripts</span></span><span class="mc-flag"></span></button>
          <button class="mode-btn" id="m-security" data-mode="security" onclick="setMode('security',true)" title="Security: Audits, ports, hardening" aria-label="Security mode"><span class="mc-ic">◉</span><span class="mc-txt"><span class="mc-name">Security</span><span class="mc-desc">Audits, ports, hardening</span></span><span class="mc-flag"></span></button>
        </div>
        <label id="sb-search"><span class="sb-sic">⌕</span><input id="cmdSearch" type="text" placeholder="Search commands" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Search commands"><span class="sb-kbd">/</span><button type="button" id="cmdSearchClear" aria-label="Clear search">×</button></label>
      </div>
      <div id="sb-panels">
      <div class="sidebar-panel show" id="panel-cmds">
        <div class="sb-grp g-sys"><div class="sb-sec">System</div>
        <button class="sb-btn" onclick="qcmd('sysinfo')" data-kw="about specs cpu os kernel"><span class="ic"><svg class="ico"><use href="#i-cpu"/></svg></span>System info</button>
        <button class="sb-btn" onclick="qcmd('processes')" data-kw="ps tasks kill top htop"><span class="ic"><svg class="ico"><use href="#i-activity"/></svg></span>Processes</button>
        <button class="sb-btn" onclick="qcmd('memory')" data-kw="ram free swap"><span class="ic"><svg class="ico"><use href="#i-memory"/></svg></span>Memory</button>
        <button class="sb-btn" onclick="qcmd('disk')" data-kw="storage space df drive"><span class="ic"><svg class="ico"><use href="#i-database"/></svg></span>Disk usage</button>
        <button class="sb-btn" onclick="qcmd('gpu')" data-kw="nvidia graphics vram"><span class="ic"><svg class="ico"><use href="#i-device-desktop"/></svg></span>GPU status</button>
        <button class="sb-btn" onclick="qcmd('services')" data-kw="systemctl daemon units"><span class="ic"><svg class="ico"><use href="#i-settings"/></svg></span>Services</button>
        <button class="sb-btn" onclick="qcmd('logs')" data-kw="journal journalctl errors"><span class="ic"><svg class="ico"><use href="#i-file-text"/></svg></span>Logs</button>
        </div>
        <div class="sb-grp g-net"><div class="sb-sec">Network</div>
        <button class="sb-btn" onclick="qcmd('network')" data-kw="ip wifi ethernet connection"><span class="ic"><svg class="ico"><use href="#i-wifi"/></svg></span>Network</button>
        <button class="sb-btn" onclick="showDevices()" data-kw="tailscale tailnet phone"><span class="ic"><svg class="ico"><use href="#i-devices"/></svg></span>Devices</button>
        <button class="sb-btn" onclick="qcmd('ports')" data-kw="listening netstat ss"><span class="ic"><svg class="ico"><use href="#i-plug-connected"/></svg></span>Open ports</button>
        </div>
        <div class="sb-grp g-tools"><div class="sb-sec">Tools</div>
        <button class="sb-btn" onclick="showGames()" data-kw="steam minecraft launcher play"><span class="ic"><svg class="ico"><use href="#i-device-gamepad-2"/></svg></span>Games</button>
        <button class="sb-btn" onclick="qcmd('screenshot')" data-kw="capture screen"><span class="ic"><svg class="ico"><use href="#i-camera"/></svg></span>Screenshot</button>
        <button class="sb-btn" onclick="qcmd('clipboard')" data-kw="copy paste"><span class="ic"><svg class="ico"><use href="#i-clipboard"/></svg></span>Clipboard</button>
        <button class="sb-btn" onclick="qcmd('volume')" data-kw="audio sound"><span class="ic"><svg class="ico"><use href="#i-volume"/></svg></span>Volume</button>
        <button class="sb-btn" onclick="qcmd('git')" data-kw="repo commit branch"><span class="ic"><svg class="ico"><use href="#i-git-branch"/></svg></span>Git status</button>
        <button class="sb-btn" onclick="qcmd('memory_recall')" data-kw="remember notes recall"><span class="ic"><svg class="ico"><use href="#i-brain"/></svg></span>My memory</button>
        </div>
        <div class="sb-nores" id="cmdNoRes" style="display:none">No commands match</div>
      </div>
    <div class="sidebar-panel" id="panel-history">
      <div class="sb-sec">Past Sessions</div>
      <div id="hist-list"></div>
    </div>
    <div class="sidebar-panel" id="panel-dash">
      <div id="dashboard">
        <div class="dash-card"><div class="dash-title">CPU %</div><div class="dash-graph"><canvas id="cpu-graph"></canvas></div></div>
        <div class="dash-card"><div class="dash-title">RAM %</div><div class="dash-graph"><canvas id="mem-graph"></canvas></div></div>
        <div class="dash-card"><div class="dash-title">GPU %</div><div class="dash-graph"><canvas id="gpu-graph"></canvas></div></div>
      </div>
    </div>
      </div>
    </div>
  </div>
  <div id="sidebar-overlay" onclick="toggleSidebar()"></div>
  <div id="chat">
    <div id="drop-ov"><div style="font-size:36px">↓</div>Drop file to attach</div>
    <div id="panel-overlay">
      <div class="panel-header">
        <div class="panel-title" id="panel-title"></div>
        <button class="panel-close" onclick="closePanel()">close</button>
      </div>
      <div id="panel-body"></div>
    </div>
    <div id="msgs"></div>
    <div id="inputbar">
      <div id="file-chip"><span>📎</span><span class="fname" id="chip-name"></span><span class="rm" onclick="clearFile()">✕</span></div>
      <div id="input-row">
        <button class="ibt" onclick="document.getElementById('fileIn').click()">📎</button>
        <input type="file" id="fileIn" style="display:none" onchange="onFile(this)" />
        <button class="ibt" id="micBtn" onclick="toggleMic()">🎙</button>
        <button class="ibt" id="ttsBtn" onclick="toggleTTS()" title="Text to speech">🔊</button>
        <textarea id="textarea" placeholder="Ask Sentinel anything..." rows="1"></textarea>
        <button class="ibt send" id="sendBtn" onclick="send()">↑</button>
      </div>
      <div id="statusbar"><span id="st-l">ready</span><span id="st-r"></span></div>
    </div>
  </div>
</div>
</div>
<div id="confirm-modal">
  <div class="confirm-box">
    <div class="confirm-icon" id="cm-icon"></div>
    <div class="confirm-title" id="cm-title"></div>
    <div class="confirm-detail" id="cm-detail"></div>
    <div class="confirm-btns">
      <button class="confirm-yes" id="cm-yes">CONFIRM</button>
      <button class="confirm-no" id="cm-no">CANCEL</button>
    </div>
  </div>
</div>
<div id="save-modal">
  <div class="confirm-box">
    <div class="confirm-title">Save File</div>
    <div style="font-size:10px;color:var(--text3);margin:10px 0 5px;">Full path (including filename)</div>
    <input id="save-path" type="text" style="width:100%;background:#0a0a0a;border:1px solid #2a2a2a;border-radius:7px;padding:9px 11px;color:var(--text);font-family:var(--mono);font-size:12px;outline:none;margin-bottom:10px;" />
    <div style="font-size:10px;color:var(--text3);margin-bottom:6px;">Quick locations</div>
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px;" id="save-quick"></div>
    <div class="confirm-btns">
      <button class="confirm-yes" id="save-yes">SAVE</button>
      <button class="confirm-no" id="save-no">CANCEL</button>
    </div>
  </div>
</div>
<script>
var msgsEl=document.getElementById('msgs');
var textarea=document.getElementById('textarea');
var sendBtn=document.getElementById('sendBtn');
var stL=document.getElementById('st-l');
var stR=document.getElementById('st-r');
var pulse=document.getElementById('pulse');
var micBtn=document.getElementById('micBtn');
