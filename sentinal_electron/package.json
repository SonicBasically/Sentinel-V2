{
  "name": "sentinel-v2",
  "version": "3.0.0",
  "description": "Sentinel V2 - Jarvis-style AI Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux"
  },
  "build": {
    "appId": "com.thomasgomez.sentinel",
    "productName": "Sentinel V2",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Utility"
    },
    "files": [
      "main.js",
      "preload.js",
      "sentinel_v2.html",
      "icon.png"
    ]
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
